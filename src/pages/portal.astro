        function renderNotificationDrawer(notifications = userTabCache.notifications) {
          const list = document.getElementById('notificationList');
          if (!list) return;

          if (!notifications.length) {
            list.innerHTML = `<div class="notification-empty">No messages right now.</div>`;
            return;
          }

          list.innerHTML = notifications.map(notification => `
            <article class="notification-item">
              <button class="notification-x" type="button" data-dismiss-notification="${notification.id}" data-occurrence-key="${escapeHtml(notification.occurrenceKey)}">×</button>
              <div class="notification-title">${escapeHtml(notification.title)}</div>
              <p>${escapeHtml(notification.body)}</p>
              <div class="notification-meta">
                ${notification.repeat_interval && notification.repeat_interval !== 'none' ? `${escapeHtml(notification.repeat_interval)} repeat` : 'Message'}
                ${notification.send_at ? ` · Sent ${new Date(notification.send_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}` : ''}
              </div>
            </article>
          `).join('');

          document.querySelectorAll('[data-dismiss-notification]').forEach(btn => {
            btn.addEventListener('click', async () => {
              const notificationId = btn.dataset.dismissNotification;
              const occurrenceKey = btn.dataset.occurrenceKey;

              await supabase
                .from('portal_notification_dismissals')
                .upsert({
                  notification_id: notificationId,
                  user_id: user.id,
                  occurrence_key: occurrenceKey
                }, { onConflict: 'notification_id,user_id,occurrence_key' });

              userTabCache.notifications = userTabCache.notifications.filter(notification => notification.id !== notificationId || notification.occurrenceKey !== occurrenceKey);
              await refreshUserNotifications({ force: true });
            });
          });
        }

        const notificationBtn = document.getElementById('notificationBtn');
        const notificationDrawer = document.getElementById('notificationDrawer');
        const closeNotificationDrawer = document.getElementById('closeNotificationDrawer');

        if (notificationBtn && notificationDrawer) {
          notificationBtn.addEventListener('click', async () => {
            notificationDrawer.classList.add('open');
            notificationDrawer.setAttribute('aria-hidden', 'false');
            await refreshUserNotifications({ force: true });
          });
        }

        if (closeNotificationDrawer && notificationDrawer) {
          closeNotificationDrawer.addEventListener('click', () => {
            notificationDrawer.classList.remove('open');
            notificationDrawer.setAttribute('aria-hidden', 'true');
          });
        }

        if (notificationDrawer) {
          notificationDrawer.addEventListener('click', (event) => {
            if (event.target === notificationDrawer) {
              notificationDrawer.classList.remove('open');
              notificationDrawer.setAttribute('aria-hidden', 'true');
            }
          });
        }

