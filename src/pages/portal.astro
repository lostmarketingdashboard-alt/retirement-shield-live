                <p>${stats.totalSubtasks ? `${stats.completedSubtasks} of ${stats.totalSubtasks} checklist items are complete.` : 'Open a task to start tracking your plan progress.'}</p>
              </div>
              <div class="plan-overview-stat">
                <strong>${stats.percent}%</strong>
