              const quizWrite = await saveProfileQuizAnswers();

              if (quizWrite.error) {
                userTabCache.profileMarkup = `<div class="profile-alert error">Your profile saved, but the onboarding answers could not be updated yet.</div>`;
              } else {
                userTabCache.profileMarkup = `<div class="profile-alert success">Your profile and onboarding answers have been updated.</div>`;
              }

              profile.full_name = fullName;
              profile.email = email;
              profile.state = state;
              profile.county = county;
              refreshPortalIdentityUI();
              await renderProfile();
            });
          }
        }

        async function loadActionPlan() {

          // 1. Load global templates
          const { data: templates } = await supabase
            .from('action_plan_templates')
            .select('*')
            .order('created_at', { ascending: true });

          if (!templates) {
            actionPlan = [];
            return;
          }

          if (templates.length === 0) {
            actionPlan = [];
            actionPlanLoaded = true;
            return;
          }

          const templateIds = templates.map(template => template.id);
          const [{ data: allSubtasks }, { data: progress }] = await Promise.all([
            supabase
              .from('action_plan_template_subtasks')
              .select('*')
              .in('template_id', templateIds)
              .order('created_at', { ascending: true }),
            supabase
              .from('user_subtask_progress')
              .select('*')
              .eq('user_id', user.id)
          ]);

          const progressBySubtask = new Map((progress || []).map(row => [row.subtask_id, row]));
          const subtasksByTemplate = (allSubtasks || []).reduce((groups, subtask) => {
            if (!groups.has(subtask.template_id)) groups.set(subtask.template_id, []);
            groups.get(subtask.template_id).push(subtask);
            return groups;
          }, new Map());

          const enrichedPlans = [];

          for (const template of templates) {

            const mergedSubtasks = (subtasksByTemplate.get(template.id) || []).map(st => {
              const match = progressBySubtask.get(st.id);
              return {
                id: st.id,
                label: st.label,
                done: match ? match.done : false
              };
            });

            // 4. Auto-calc status from subtasks
            let status = 'queued';
            if (mergedSubtasks.length) {
              if (mergedSubtasks.every(s => s.done)) status = 'complete';
              else if (mergedSubtasks.some(s => s.done)) status = 'progress';
            }

            enrichedPlans.push({
              id: template.id,
              title: template.title,
              category: template.category,
              details: template.details,
              status,
              subtasks: mergedSubtasks
            });
          }

          actionPlan = enrichedPlans;
          actionPlanLoaded = true;
        }

        function calculateStats() {
          const completed = actionPlan.filter(a => a.status === 'complete').length
          const inProgress = actionPlan.filter(a => a.status === 'progress').length
          const queued = actionPlan.filter(a => a.status === 'queued').length
          const totalSubtasks = actionPlan.reduce((sum, item) => sum + item.subtasks.length, 0)
          const completedSubtasks = actionPlan.reduce((sum, item) => sum + item.subtasks.filter(subtask => subtask.done).length, 0)
          const totalPlanItems = actionPlan.length
          const percent = totalSubtasks
            ? Math.round((completedSubtasks / totalSubtasks) * 100)
            : totalPlanItems
              ? Math.round((completed / totalPlanItems) * 100)
              : 0

          return { completed, inProgress, queued, totalSubtasks, completedSubtasks, totalPlanItems, percent }
        }

        function updateHeroStats(stats) {
          const completeBadge = document.querySelector('.badge-complete')
          const progressBadge = document.querySelector('.badge-progress')
          const queuedBadge = document.querySelector('.badge-queued')
          const progressValue = document.getElementById('portalProgressValue')
          const progressRing = document.getElementById('portalProgressRing')
          const heroSubtext = document.getElementById('portalHeroSubtext')
          const reviewDate = document.getElementById('portalReviewDate')
          const reviewSub = document.getElementById('portalReviewSub')

          if (completeBadge) completeBadge.innerText = `${stats.completed} Completed`
          if (progressBadge) progressBadge.innerText = `${stats.inProgress} In Progress`
          if (queuedBadge) queuedBadge.innerText = `${stats.queued} Queued`
          if (progressValue) progressValue.innerText = `${stats.percent}%`
          if (progressRing) progressRing.style.setProperty('--progress-deg', `${Math.round(stats.percent * 3.6)}deg`)

          if (heroSubtext) {
            if (!stats.totalPlanItems) {
              heroSubtext.textContent = 'Your action plan is ready for setup. Once tasks are added, progress will appear here.'
            } else {
              const taskCopy = stats.totalSubtasks
                ? `${stats.completedSubtasks} of ${stats.totalSubtasks} checklist items complete`
                : `${stats.completed} of ${stats.totalPlanItems} plan items complete`
              heroSubtext.textContent = `${taskCopy}. Your next best move is the first open item below.`
            }
          }

          if (reviewDate && reviewSub) {
            reviewDate.textContent = stats.percent >= 100 ? 'Ready' : 'Schedule'
            reviewSub.textContent = stats.percent >= 100
              ? 'Your plan is ready for a check-in'
              : 'Set the next advisor check-in'
          }
        }

        async function renderPlan() {
          const stats = calculateStats()
          updateHeroStats(stats)

          // Preserve which card is open
          const openCard = document.querySelector('.plan-card.open')
          const openId = openCard ? openCard.dataset.id : null

          contentDiv.innerHTML = `
