---
import { supabase } from '../../lib/supabase'
import CountyLayout from '../../layouts/CountyLayout.astro'

export const prerender = true;

const retirementSpend = 72000

export async function getStaticPaths() {
  const retirementSpend = 72000

  const slugify = (value) => String(value || '')
    .toLowerCase()
    .replace(/\s+/g, '-')
    .trim()

  async function fetchAllRows(table, columns) {
    const rows = []
    let from = 0
    const batchSize = 1000

    while (true) {
      const { data, error } = await supabase
        .from(table)
        .select(columns)
        .range(from, from + batchSize - 1)

      if (error) {
        console.error(`Unable to build ${table} rows:`, error)
        break
      }

      if (!data?.length) break

      rows.push(...data)
      from += batchSize
    }

    return rows
  }

  const [allRows, populationRows, ssaResponse] = await Promise.all([
    fetchAllRows('counties', 'State, County, "Life Expectancy (Years)"'),
    fetchAllRows('county_population', 'state, county, population'),
    supabase
      .from('ssa_life_tables')
      .select('ex')
      .eq('birth_year', 2020)
      .eq('sex', 'Male')
      .eq('age', 65)
      .single()
  ])

  const allLifeValues = allRows
    .map(row => row["Life Expectancy (Years)"])
    .filter(value => typeof value === 'number')

  const nationalAverage = allLifeValues.length
    ? allLifeValues.reduce((sum, value) => sum + value, 0) / allLifeValues.length
    : 0

  const populationByCounty = new Map(
    populationRows.map(row => [`${slugify(row.state)}:${slugify(row.county)}`, row.population])
  )

  const groupedByState = new Map()
  const groupedByCounty = new Map()

  allRows.forEach(row => {
    if (!row?.State || !row?.County) return

    const stateSlug = slugify(row.State)
    const countySlug = slugify(row.County.replace(' County', ''))
    const key = `${stateSlug}:${countySlug}`
    const value = row["Life Expectancy (Years)"]

    if (!groupedByState.has(stateSlug)) groupedByState.set(stateSlug, [])
    groupedByState.get(stateSlug).push(row)

    if (!groupedByCounty.has(key)) {
      groupedByCounty.set(key, {
        stateName: row.State,
        stateSlug,
        countyName: row.County,
        countySlug,
        values: []
      })
    }

    if (typeof value === 'number') groupedByCounty.get(key).values.push(value)
  })

  const stateCountiesByState = new Map()
  groupedByState.forEach((rows, stateSlug) => {
    const countyGroups = new Map()

    rows.forEach(row => {
      const countyName = row.County.replace(' County', '')
      const countySlug = slugify(countyName)
      const value = row["Life Expectancy (Years)"]

      if (!countyGroups.has(countySlug)) {
        countyGroups.set(countySlug, {
          name: countyName,
          values: []
        })
      }

      if (typeof value === 'number') countyGroups.get(countySlug).values.push(value)
    })

    stateCountiesByState.set(stateSlug, Array.from(countyGroups.entries()).map(([countySlug, group]) => {
      const avg = group.values.length
        ? group.values.reduce((sum, value) => sum + value, 0) / group.values.length
        : 0
      const diff = avg - nationalAverage
      const nearbyPlan20 = retirementSpend * 20
      const nearbyPlan30 = retirementSpend * 30

      return {
        name: group.name,
        lifeExpectancy: avg.toFixed(2),
        difference: diff.toFixed(2),
        survival75: Math.max(0, Math.min(100, Math.round(85 + (diff * 2)))),
        survival85: Math.max(0, Math.min(100, Math.round(50 + (diff * 3)))),
        survival95: Math.max(0, Math.min(100, Math.round(12 + (diff * 2)))),
        survival90: Math.max(0, Math.min(100, Math.round(28 + (diff * 2)))),
        ssRecommendation: diff > 0 ? 70 : 67,
        savingsGap: ((nearbyPlan30 - nearbyPlan20) / 1000000).toFixed(2),
        href: `/${stateSlug}/${countySlug}`
      }
    }))
  })

  return Array.from(groupedByCounty.values()).map((countyGroup) => {
    const countyAverage = countyGroup.values.length
      ? countyGroup.values.reduce((sum, value) => sum + value, 0) / countyGroup.values.length
      : 0

    return {
      params: {
        state: countyGroup.stateSlug,
        county: countyGroup.countySlug
      },
      props: {
        countyName: countyGroup.countyName,
        stateName: countyGroup.stateName,
        countyAverage,
        nationalAverage,
        stateCounties: stateCountiesByState.get(countyGroup.stateSlug) || [],
        population: populationByCounty.get(`${countyGroup.stateSlug}:${countyGroup.countySlug}`) ?? null,
        lifeAt65: ssaResponse.data?.ex ?? 0
      }
    }
  })
}

const {
  countyName,
  stateName,
  countyAverage = 0,
  nationalAverage = 0,
  stateCounties = [],
  population = null,
  lifeAt65 = 0
} = Astro.props

const difference = countyAverage - nationalAverage

// ─────────────────────────────
// DERIVED VALUES
// ─────────────────────────────

const survival75 = Math.max(0, Math.min(100, Math.round(85 + (difference * 2))))
const survival85 = Math.max(0, Math.min(100, Math.round(50 + (difference * 3))))
const survival95 = Math.max(0, Math.min(100, Math.round(12 + (difference * 2))))

const survival90 = Math.max(0, Math.min(100, Math.round(28 + (difference * 2))))

const prob90 = survival90
const s90National = 28

const s75County = survival75
const s75State = 84
const s75National = 83

const s85County = survival85
const s85State = 52
const s85National = 50

const s95County = survival95
const s95State = 13
const s95National = 12

const plan20 = retirementSpend * 20
const plan30 = retirementSpend * 30
const additionalCapital = plan30 - plan20
---


<CountyLayout
  countyName={countyName}
  stateName={stateName}
  countyAverage={countyAverage.toFixed(2)}
  nationalAverage={nationalAverage.toFixed(2)}
  difference={difference}
  lifeAt65={lifeAt65}

  s75County={s75County}
  s75State={s75State}
  s75National={s75National}

  s85County={s85County}
  s85State={s85State}
  s85National={s85National}

  s95County={s95County}
  s95State={s95State}
  s95National={s95National}

  prob90={prob90}
  s90National={s90National}

  stateCounties={stateCounties}
  population={population}
/>
