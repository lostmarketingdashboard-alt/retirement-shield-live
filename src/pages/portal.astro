        async function renderUsers() {
          const users = await getAdminData('users');

          const safeUsers = users || [];
          const paidUsers = safeUsers.filter(u => u.paid).length;
          const admins = safeUsers.filter(u => u.role === 'admin').length;
          const unpaidUsers = safeUsers.filter(u => u.role === 'user' && !u.paid).length;

          contentDiv.innerHTML = `
            ${adminHeader({
              kicker: 'Admin',
              title: 'Members',
              copy: 'Search members, review account status, change roles, and inspect the latest quiz submission.',
              stats: [
                { value: String(safeUsers.length), label: 'Total members' },
                { value: String(paidUsers), label: 'Paid' },
                { value: String(unpaidUsers), label: 'Unpaid users' },
                { value: String(admins), label: 'Admins' }
              ]
            })}

            <div class="admin-toolbar">
              <input id="adminUserSearch" class="portal-search" type="text" placeholder="Search members by name, email, or role..." />
              <button class="view-pdf-btn admin-tab-jump" data-admin-jump="add-users">Add User</button>
            </div>

            <div class="admin-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>Registered Accounts</h3>
                  <div class="doc-meta">Click a member row to view latest quiz answers.</div>
                </div>
              </div>

              <div class="admin-list">
                ${safeUsers.length ? safeUsers.map(u => `
                  <article class="admin-row user-card" data-user="${u.id}" data-admin-search="${escapeHtml(`${u.full_name ?? ''} ${u.email ?? ''} ${u.role ?? ''} ${u.paid ? 'paid' : 'unpaid'}`)}">
                    <div class="admin-row-main user-row">
                      <div class="admin-avatar">${getInitials(u.full_name)}</div>
                      <div class="admin-row-copy">
                        <strong>${escapeHtml(u.full_name ?? 'No Name')}</strong>
                        <span>${escapeHtml(u.email ?? '')}</span>
                        <div class="admin-pill-row">
                          <span class="admin-pill">${escapeHtml(u.role ?? 'user')}</span>
                          <span class="admin-pill ${u.paid ? 'success' : 'warn'}">${u.paid ? 'Paid' : 'Unpaid'}</span>
                          <span class="admin-pill">Joined ${formatAdminDate(u.created_at)}</span>
                        </div>
                      </div>
                    </div>
                    <div class="admin-row-actions">
                        <select data-user="${u.id}" class="role-select profile-input">
                          <option value="user" ${u.role === 'user' ? 'selected' : ''}>User</option>
                          <option value="admin" ${u.role === 'admin' ? 'selected' : ''}>Admin</option>
                          <option value="referral" ${u.role === 'referral' ? 'selected' : ''}>Referral</option>
                        </select>
                        <select data-paid-user="${u.id}" class="paid-select profile-input">
                          <option value="true" ${u.paid ? 'selected' : ''}>Paid</option>
                          <option value="false" ${!u.paid ? 'selected' : ''}>Unpaid</option>
                        </select>
                        <button data-delete="${u.id}" class="btn-delete delete-user-btn">
                          Delete
                        </button>
                    </div>
                    <div class="user-answers admin-answer-panel"></div>
                  </article>
                `).join('') : adminEmpty('No members found', 'There are no non-referral accounts yet.')}
              </div>
            </div>
          `

          document.querySelectorAll('.admin-tab-jump').forEach(btn => {
            btn.addEventListener('click', () => {
              const target = btn.dataset.adminJump;
              document.querySelectorAll('.tab').forEach(t => t.classList.remove('active'));
              const tab = document.querySelector(`.tab[data-tab="${target}"]`);
              if (tab) tab.classList.add('active');
              if (target === 'add-users') renderAddUsers();
            });
          });

          const userSearch = document.getElementById('adminUserSearch');
          userSearch?.addEventListener('input', () => {
            const query = userSearch.value.trim().toLowerCase();
            document.querySelectorAll('.user-card').forEach(card => {
              card.style.display = !query || (card.dataset.adminSearch || '').toLowerCase().includes(query) ? '' : 'none';
            });
          });

          document.querySelectorAll('.role-select').forEach(select => {
            select.addEventListener('change', async (e) => {
              const userId = e.target.dataset.user
              const newRole = e.target.value

              await supabase
                .from('profiles')
                .update({ role: newRole })
                .eq('id', userId)

              invalidateAdminData('users', 'team', 'referrals')
              renderUsers()
            })
          })

          document.querySelectorAll('.paid-select').forEach(select => {
            select.addEventListener('change', async (e) => {
              const userId = e.target.dataset.paidUser
              const paid = e.target.value === 'true'

              const { error } = await supabase
                .from('profiles')
                .update({ paid })
                .eq('id', userId)

              if (error) {
                alert('Error updating paid status.')
                console.error(error)
                renderUsers()
                return
              }

              invalidateAdminData('users')
              renderUsers()
            })
          })

          document.querySelectorAll('.delete-user-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              const userId = e.target.dataset.delete

              const confirmed = confirm("Are you sure you want to permanently delete this user? This action cannot be undone.")

              if (!confirmed) return

              const { error } = await supabase
                .from('profiles')
                .delete()
                .eq('id', userId)

              if (error) {
                alert("Error deleting user.")
                console.error(error)
                return
              }

              invalidateAdminData('users', 'team', 'referrals', 'assignmentRows')
              renderUsers()
            })
          })

          // User row expand/collapse and show quiz answers
          document.querySelectorAll('.user-card').forEach(card => {
            card.querySelector('.user-row').addEventListener('click', async (e) => {

              // Prevent click from firing when clicking buttons/select
              if (e.target.closest('select') || e.target.closest('button')) return

              const userId = card.dataset.user
              const answersContainer = card.querySelector('.user-answers')

              // Toggle close if already open
              if (answersContainer.classList.contains('open')) {
                answersContainer.classList.remove('open')
                answersContainer.innerHTML = ''
                return
              }

              // Close other open cards
              document.querySelectorAll('.user-answers').forEach(a => {
                a.classList.remove('open')
                a.innerHTML = ''
              })

              const { data, error } = await supabase
                .from('quiz_submissions')
                .select('answers')
                .eq('user_id', userId)
                .order('created_at', { ascending: false })
                .limit(1)
                .single()

              if (error || !data) {
                answersContainer.innerHTML = '<p>No quiz submission found.</p>'
                answersContainer.classList.add('open')
                return
              }

              const answers = data.answers || {}

              answersContainer.innerHTML = `
                <table class="admin-table">
                  ${Object.entries(answers).map(([key, value]) => `
                    <tr>
                      <td>${escapeHtml(key)}</td>
                      <td>${escapeHtml(value)}</td>
                    </tr>
                  `).join('')}
                </table>
              `

              answersContainer.classList.add('open')
            })
          })
        }

        async function renderActionTasks() {
          // --- Step 1: Add edit mode state ---
          let editingTemplateId = null;

          const [templates, templateSubtasks] = await Promise.all([
            getAdminData('templates'),
            getAdminData('templateSubtasks')
          ]);

          const subtaskCounts = (templateSubtasks || []).reduce((counts, subtask) => {
            counts[subtask.template_id] = (counts[subtask.template_id] || 0) + 1;
            return counts;
          }, {});

          contentDiv.innerHTML = `
            ${adminHeader({
              kicker: 'Action Tasks',
              title: 'Plan Templates',
              copy: 'Create and maintain the global action plan templates that every user sees in their portal.',
              stats: [
                { value: String(templates.length), label: 'Templates' },
                { value: String(templateSubtasks.length), label: 'Checklist items' }
              ]
            })}

            <div class="admin-layout">
              <section class="admin-panel">
                <div class="admin-panel-head">
                  <div>
                    <h3 id="templateFormTitle">Create Template</h3>
                    <div class="doc-meta">Add a title, category, and checklist items.</div>
                  </div>
                </div>

                <div class="admin-form">
                  <label>
                    <span>Title</span>
                    <input id="newTitle" class="profile-input" placeholder="e.g. Beneficiary review">
                  </label>

                  <label>
                    <span>Category</span>
                    <input id="newCategory" class="profile-input" placeholder="e.g. Estate, Income, Tax">
                  </label>

                  <div id="subtaskContainer" class="admin-subtask-list"></div>

                  <div class="admin-form-actions">
                    <button id="addSubtaskBtn" class="portal-secondary-btn" type="button">Add Checklist Item</button>
                    <button id="createPlanBtn" class="view-pdf-btn" type="button">Create Template</button>
                  </div>
                </div>
              </section>

              <section class="admin-panel">
                <div class="admin-panel-head">
                  <div>
                    <h3>Existing Templates</h3>
                    <div class="doc-meta">Edit wording, categories, and checklist structure.</div>
                  </div>
                </div>

                <div class="admin-list compact">
                  ${templates.length ? templates.map(t => `
                    <article class="admin-row">
                      <div class="admin-row-main">
                        <div class="admin-avatar">${escapeHtml((t.category || 'RS').slice(0, 2).toUpperCase())}</div>
                        <div class="admin-row-copy">
                          <strong>${escapeHtml(t.title ?? 'Untitled')}</strong>
                          <span>${escapeHtml(t.category ?? 'No category')}</span>
                          <div class="admin-pill-row">
                            <span class="admin-pill">${subtaskCounts[t.id] || 0} checklist items</span>
                          </div>
                        </div>
                      </div>
                      <div class="admin-row-actions">
                        <button data-edit="${t.id}" class="btn-edit edit-template-btn">Edit</button>
                        <button data-delete="${t.id}" class="btn-delete">Delete</button>
                      </div>
                    </article>
                  `).join('') : adminEmpty('No templates yet', 'Create the first global plan template using the form.')}
                </div>
              </section>
            </div>
          `;

          // -------- Checklist logic --------
          const subtaskContainer = document.getElementById('subtaskContainer');
          const addSubtaskBtn = document.getElementById('addSubtaskBtn');

          function addSubtaskInput(value = '') {
            const wrapper = document.createElement('div');
            wrapper.style.display = 'flex';
            wrapper.style.gap = '8px';
            wrapper.style.marginBottom = '8px';

            wrapper.innerHTML = `
              <input type="text"
                class="subtask-input"
                placeholder="Checklist item"
                value="${escapeHtml(value)}">
              <button class="remove-subtask btn-delete" type="button">
                Remove
              </button>
            `;

            wrapper.querySelector('.remove-subtask').addEventListener('click', () => {
              wrapper.remove();
            });

            subtaskContainer.appendChild(wrapper);
          }

          addSubtaskBtn.addEventListener('click', () => addSubtaskInput());

          // --- Step 3: Unified create/edit handler ---
          const createBtn = document.getElementById('createPlanBtn');
          createBtn.addEventListener('click', async () => {

            const title = document.getElementById('newTitle').value.trim();
            const category = document.getElementById('newCategory').value.trim();

            if (!title) return alert("Title required.");

            // --- EDIT MODE ---
            if (editingTemplateId) {

              await supabase
                .from('action_plan_templates')
                .update({ title, category })
                .eq('id', editingTemplateId);

              await supabase
                .from('action_plan_template_subtasks')
                .delete()
                .eq('template_id', editingTemplateId);

              const subtaskInputs = document.querySelectorAll('.subtask-input');
              const subtasks = [];

              subtaskInputs.forEach(input => {
                if (input.value.trim()) {
                  subtasks.push({
                    template_id: editingTemplateId,
                    label: input.value.trim()
                  });
                }
              });

              if (subtasks.length) {
                await supabase.from('action_plan_template_subtasks').insert(subtasks);
              }

              editingTemplateId = null;
              createBtn.innerText = "Create Template";
              document.getElementById('templateFormTitle').textContent = 'Create Template';
            }

            // --- CREATE MODE ---
            else {

              const { data: template, error } = await supabase
                .from('action_plan_templates')
                .insert({ title, category })
                .select()
                .single();

              if (error) return alert("Error creating template.");

              const subtaskInputs = document.querySelectorAll('.subtask-input');
              const subtasks = [];

              subtaskInputs.forEach(input => {
                if (input.value.trim()) {
                  subtasks.push({
                    template_id: template.id,
                    label: input.value.trim()
                  });
                }
              });

              if (subtasks.length) {
                await supabase.from('action_plan_template_subtasks').insert(subtasks);
              }
            }

            invalidateAdminData('templates', 'templateSubtasks');

            // Reset form
            document.getElementById('newTitle').value = '';
            document.getElementById('newCategory').value = '';
            subtaskContainer.innerHTML = '';

            renderActionTasks();
          });

          // -------- DELETE TEMPLATE --------
          document.querySelectorAll('[data-delete]').forEach(btn => {
            btn.addEventListener('click', async (e) => {

              const id = e.target.dataset.delete;
              if (!confirm("Delete this template?")) return;

              await supabase.from('action_plan_template_subtasks').delete().eq('template_id', id);
              await supabase.from('action_plan_templates').delete().eq('id', id);

              invalidateAdminData('templates', 'templateSubtasks');
              renderActionTasks();
            });
          });

          // -------- EDIT TEMPLATE --------
          document.querySelectorAll('.edit-template-btn').forEach(btn => {
            btn.addEventListener('click', async (e) => {

              const id = e.target.dataset.edit;

              // Load template
              const { data: template } = await supabase
                .from('action_plan_templates')
                .select('*')
                .eq('id', id)
                .single();

              if (!template) return alert("Template not found.");

              // Load subtasks
              const { data: subtasks } = await supabase
                .from('action_plan_template_subtasks')
                .select('*')
                .eq('template_id', id)
                .order('created_at', { ascending: true });

              // Populate form
              document.getElementById('newTitle').value = template.title || '';
              document.getElementById('newCategory').value = template.category || '';

              const subtaskContainer = document.getElementById('subtaskContainer');
              subtaskContainer.innerHTML = '';

              (subtasks || []).forEach(st => {
                addSubtaskInput(st.label);
              });

              // Step 4: Set edit mode state & button label
              editingTemplateId = id;
              createBtn.innerText = "Save Changes";
              document.getElementById('templateFormTitle').textContent = 'Edit Template';
              document.getElementById('newTitle').scrollIntoView({ behavior: 'smooth', block: 'center' });
            });
          });
        }

