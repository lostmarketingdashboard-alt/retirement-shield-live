            if (onboardingSaveTimer) window.clearTimeout(onboardingSaveTimer);
            onboardingSaveTimer = window.setTimeout(async () => {
              const runId = ++onboardingSaveRun;
              const result = await saveProfileQuizAnswers();
              if (runId !== onboardingSaveRun) return;

              if (result.error) {
                showPortalStatusToast('Unable to save', 'That quiz answer was not saved. Please try again.');
                return;
