        async function populateProfileCountyOptions(stateName, selectedCounty = '') {
          const countySelect = document.getElementById('profileCounty');
          if (!countySelect) return;

          countySelect.innerHTML = '<option value="">Select your county</option>';

          if (!stateName) {
            countySelect.disabled = true;
            return;
          }

          countySelect.disabled = true;
          const { data, error } = await supabase
            .from('county_population')
            .select('county')
            .eq('state', normalizeCountyState(stateName))
            .order('county', { ascending: true });

          if (error) {
            console.error('County fetch error:', error);
            countySelect.disabled = false;
            if (selectedCounty) {
              countySelect.innerHTML = `<option value="${escapeHtml(selectedCounty)}" selected>${escapeHtml(selectedCounty)}</option>`;
            }
            return;
          }

          const countyOptions = (data || []).map(row => row.county).filter(Boolean);
          if (selectedCounty && !countyOptions.includes(selectedCounty)) {
            countyOptions.unshift(selectedCounty);
          }
          countySelect.innerHTML = `
            <option value="">Select your county</option>
            ${countyOptions.map(county => `<option value="${escapeHtml(county)}" ${selectedCounty === county ? 'selected' : ''}>${escapeHtml(county)}</option>`).join('')}
          `;
          countySelect.disabled = false;
        }

        function collectProfileQuizAnswers(baseAnswers = {}) {
          const fullName = document.getElementById('profileFullName')?.value.trim() || profile.full_name || '';
