        function getNotificationOccurrenceKey(notification, now = new Date()) {
          const sendDate = notification.send_at ? new Date(notification.send_at) : new Date(notification.created_at || Date.now());
          const start = Number.isNaN(sendDate.getTime()) ? new Date(notification.created_at || Date.now()) : sendDate;
          const interval = notification.repeat_interval || 'none';

          if (interval === 'daily') {
            return now.toISOString().slice(0, 10);
          }

          if (interval === 'weekly') {
            const startOfWeek = new Date(Date.UTC(now.getUTCFullYear(), now.getUTCMonth(), now.getUTCDate()));
            const day = startOfWeek.getUTCDay() || 7;
            startOfWeek.setUTCDate(startOfWeek.getUTCDate() - day + 1);
            return startOfWeek.toISOString().slice(0, 10);
          }

          if (interval === 'monthly') {
            return `${now.getUTCFullYear()}-${String(now.getUTCMonth() + 1).padStart(2, '0')}`;
          }

          return `once-${notification.id}-${start.toISOString()}`;
        }

        function isNotificationDue(notification, now = new Date()) {
          if (!notification.active) return false;

          const sendDate = notification.send_at ? new Date(notification.send_at) : null;
          if (sendDate && sendDate > now) return false;

          const repeatUntil = notification.repeat_until ? new Date(notification.repeat_until) : null;
          if (repeatUntil && repeatUntil < now) return false;

          if (notification.recipient_user_id && notification.recipient_user_id !== user.id) return false;
          if (!notification.recipient_user_id && !['all', profile.role].includes(notification.audience || 'all')) return false;

          return true;
        }

        async function getUserNotifications({ force = false } = {}) {
          if (!force && userTabCache.notifications.length) return userTabCache.notifications;
          if (!force && userTabCache.notificationsPromise) return userTabCache.notificationsPromise;

          userTabCache.notificationsPromise = (async () => {
            const now = new Date();
            const { data: notifications, error } = await supabase
              .from('portal_notifications')
              .select('*')
              .eq('active', true)
              .or(`send_at.is.null,send_at.lte.${now.toISOString()}`)
              .order('created_at', { ascending: false });

            if (error) {
              console.error(error);
              userTabCache.notifications = [];
              return [];
            }

            const relevant = (notifications || [])
              .filter(notification => isNotificationDue(notification, now))
              .map(notification => ({
                ...notification,
                occurrenceKey: getNotificationOccurrenceKey(notification, now)
              }));

            if (!relevant.length) {
              userTabCache.notifications = [];
              return [];
            }

            const { data: dismissals } = await supabase
              .from('portal_notification_dismissals')
              .select('notification_id, occurrence_key')
              .eq('user_id', user.id);

            const dismissed = new Set((dismissals || []).map(row => `${row.notification_id}:${row.occurrence_key}`));
            userTabCache.notifications = relevant.filter(notification => !dismissed.has(`${notification.id}:${notification.occurrenceKey}`));
            return userTabCache.notifications;
          })();

          try {
            return await userTabCache.notificationsPromise;
          } finally {
            userTabCache.notificationsPromise = null;
          }
        }

        async function refreshUserNotifications({ force = false } = {}) {
          const notifications = await getUserNotifications({ force });
          const countEl = document.getElementById('notificationCount');
          const btn = document.getElementById('notificationBtn');
          if (countEl) countEl.textContent = String(notifications.length);
          if (btn) btn.classList.toggle('has-notifications', notifications.length > 0);
