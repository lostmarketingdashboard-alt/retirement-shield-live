        function trafficDonut(title, subtitle, rows) {
          const total = rows.reduce((sum, row) => sum + row.views, 0);
          let offset = 25;
          const colors = ['#c8821a', '#0d1b2a', '#2d6a4f', '#8a6f4d', '#d9b166'];
          const circles = rows.slice(0, 5).map((row, index) => {
            const share = total ? (row.views / total) * 100 : 0;
            const circle = `<circle r="15.9155" cx="18" cy="18" fill="transparent" stroke="${colors[index % colors.length]}" stroke-width="4.2" stroke-dasharray="${share} ${100 - share}" stroke-dashoffset="${offset}" />`;
            offset -= share;
            return circle;
          }).join('');

          return `
            <section class="admin-panel traffic-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>${escapeHtml(title)}</h3>
                  <div class="doc-meta">${escapeHtml(subtitle)}</div>
                </div>
              </div>
              <div class="traffic-donut-layout">
                <div class="traffic-donut">
                  <svg viewBox="0 0 36 36" aria-hidden="true">
                    <circle r="15.9155" cx="18" cy="18" fill="transparent" stroke="rgba(200,184,154,.26)" stroke-width="4.2" />
                    ${circles}
                  </svg>
                  <div>
                    <strong>${total}</strong>
                    <span>views</span>
                  </div>
                </div>
                <div class="traffic-legend">
                  ${rows.length ? rows.slice(0, 5).map((row, index) => `
                    <div class="traffic-legend-row">
                      <span style="background:${colors[index % colors.length]}"></span>
                      <strong>${escapeHtml(row.label || row.key)}</strong>
                      <em>${row.views}</em>
                    </div>
                  `).join('') : `<div class="traffic-empty">No device data yet.</div>`}
                </div>
              </div>
            </section>
          `;
        }

        function trafficTrendChart(rows) {
          const maxViews = Math.max(...rows.map(row => row.views), 1);
          const totalViews = rows.reduce((sum, row) => sum + row.views, 0);

          if (!totalViews) {
            return `
              <section class="admin-panel traffic-panel traffic-trend-panel">
                <div class="admin-panel-head">
                  <div>
                    <h3>Daily Traffic Trend</h3>
                    <div class="doc-meta">Page views by day for the selected range.</div>
                  </div>
                </div>
                <div class="traffic-empty-state">
                  <strong>No tracked visits yet</strong>
                  <span>Once public pages receive traffic, this card will show the daily trend here.</span>
                </div>
              </section>
            `;
          }

          const points = rows.map((row, index) => {
            const x = rows.length === 1 ? 50 : (index / (rows.length - 1)) * 100;
            const y = 92 - ((row.views / maxViews) * 72);
            return `${x.toFixed(2)},${y.toFixed(2)}`;
          }).join(' ');
          const areaPoints = `0,96 ${points} 100,96`;

          return `
            <section class="admin-panel traffic-panel traffic-trend-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>Daily Traffic Trend</h3>
                  <div class="doc-meta">Page views by day for the selected range.</div>
                </div>
              </div>
              <div class="traffic-trend-chart">
                <svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true">
                  <polyline points="0,92 100,92" class="traffic-grid-line"></polyline>
                  <polyline points="0,68 100,68" class="traffic-grid-line"></polyline>
                  <polyline points="0,44 100,44" class="traffic-grid-line"></polyline>
                  <polygon points="${areaPoints}" class="traffic-area"></polygon>
                  <polyline points="${points}" class="traffic-line"></polyline>
                </svg>
              </div>
              <div class="traffic-trend-bars">
                ${rows.map((row, index) => `
                  <div class="traffic-day">
                    <div style="height:${Math.max(8, Math.round((row.views / maxViews) * 74))}%"></div>
                    <strong>${row.views}</strong>
                    <span>${index === 0 || index === rows.length - 1 || rows.length <= 14 ? escapeHtml(row.label) : ''}</span>
                  </div>
                `).join('')}
              </div>
            </section>
          `;
        }

        async function renderTraffic(days = 30) {
          let events = [];

          try {
            events = await getAdminData('traffic');
          } catch (error) {
            console.error(error);
            contentDiv.innerHTML = `<div class="doc-card"><p style="color:red;">Error loading traffic analytics. Make sure sql/traffic_analytics.sql has been run in Supabase.</p></div>`;
            return;
          }

          const summary = summarizeTraffic(events, days);
          const activeRange = String(days);

          contentDiv.innerHTML = `
            ${adminHeader({
              kicker: 'Traffic',
              title: 'Website Analytics',
              copy: 'Monitor public page traffic, state guide demand, and county-level interest across Retirement Shield.',
              stats: [
                { value: String(summary.totalViews), label: 'Page views' },
                { value: String(summary.uniqueVisitors), label: 'Visitors' },
                { value: String(summary.stateCount), label: 'States' },
                { value: String(summary.countyCount), label: 'Counties' }
              ]
            })}

            <div class="traffic-toolbar admin-panel">
              <div>
                <h3>Reporting Window</h3>
                <div class="doc-meta">Switch between recent traffic ranges. Data loads from the last 90 days.</div>
              </div>
              <div class="traffic-range-controls">
                ${[7, 30, 90].map(range => `
                  <button type="button" class="traffic-range-btn ${activeRange === String(range) ? 'active' : ''}" data-traffic-range="${range}">
                    ${range} days
                  </button>
                `).join('')}
              </div>
            </div>

            <div class="traffic-chart-grid">
              ${trafficTrendChart(summary.daily)}
              ${trafficDonut('Device Mix', 'Desktop, mobile, and tablet traffic as a share of total views.', summary.devices)}
            </div>

            <div class="traffic-grid">
              ${trafficBarChart('Top Pages', 'Which public pages are getting the most visits.', summary.pages)}
              ${trafficBarChart('Top States', 'State guide/probate/county traffic grouped by state.', summary.states)}
              ${trafficBarChart('Top Counties', 'County page traffic grouped by county and state.', summary.counties)}
              ${trafficBarChart('Sources', 'UTM source when present, otherwise referring domain/direct.', summary.sources)}
            </div>

            <section class="admin-panel traffic-panel traffic-recent-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>Recent Visits</h3>
                  <div class="doc-meta">Latest tracked public page views.</div>
                </div>
              </div>
              <div class="traffic-recent-table">
                <div class="traffic-recent-head">
                  <span>Page</span>
                  <span>Location</span>
                  <span>Device</span>
                  <span>Source</span>
                  <span>Visited</span>
                </div>
                ${summary.events.slice(0, 18).map(event => `
                  <article class="traffic-recent-row">
                    <div class="traffic-recent-page">
                      <strong>${escapeHtml(event.page_title || event.normalized_path || 'Page view')}</strong>
                      <span>${escapeHtml(event.normalized_path || event.page_path || '')}</span>
                    </div>
                    <div>${escapeHtml([event.county_name, event.state_name].filter(Boolean).join(', ') || 'General')}</div>
                    <div><span class="admin-pill">${escapeHtml(event.device_type || 'unknown')}</span></div>
                    <div>${escapeHtml(getTrafficSourceLabel(event))}</div>
                    <div>${formatAdminDate(event.created_at)}</div>
                  </article>
                `).join('') || `<div class="traffic-empty">Visits will appear here once the tracker records page views.</div>`}
              </div>
            </section>
          `;

          document.querySelectorAll('[data-traffic-range]').forEach(btn => {
            btn.addEventListener('click', () => renderTraffic(Number(btn.dataset.trafficRange)));
          });
        }

        // --- ADMIN: ARTICLES MANAGEMENT FUNCTION ---
        async function renderArticles() {

          let articles = [];

          try {
            articles = await getAdminData('articles');
          } catch (error) {
            console.error(error);
            contentDiv.innerHTML = `<div class="doc-card"><p style="color:red;">Error loading articles.</p></div>`;
            return;
          }

          contentDiv.innerHTML = `
            ${adminHeader({
              kicker: 'Content',
              title: 'Articles',
              copy: 'Search, preview, edit, and publish article records used by the public site.',
              stats: [
                { value: String(articles.length), label: 'Articles' },
                { value: String(new Set(articles.map(a => a.pillar).filter(Boolean)).size), label: 'Pillars' }
              ]
            })}

            <div class="admin-panel">
              <div class="admin-panel-head">
                <div>
                  <h3>Content Library</h3>
                  <div class="doc-meta">Click a headline to preview its lede.</div>
                </div>
                <button id="addArticleBtn" class="view-pdf-btn">Add Article</button>
              </div>

                <input 
                  type="text" 
                  id="articleSearch"
                  placeholder="Search by title, slug, or pillar..."
                  class="portal-search admin-search"
                />

              <div class="admin-table-wrap">
                <table class="admin-table article-table">
                  <thead>
                    <tr>
                      <th>Title</th>
                      <th>Slug</th>
                      <th>Pillar</th>
                      <th>Actions</th>
                    </tr>
                  </thead>
                  <tbody>
                    ${articles.map(a => `
                      <tr>
                        <td>
                          <div class="article-title" data-expand="${a.id}">
                            ${escapeHtml(a.headline ?? 'Untitled')}
                          </div>
                          <div id="expand-${a.id}" class="article-preview">
                            ${escapeHtml(a.lede ?? '')}
                          </div>
                        </td>
                        <td>${escapeHtml(a.slug ?? '')}</td>
                        <td><span class="admin-pill">${escapeHtml(a.pillar ?? 'Unassigned')}</span></td>
                        <td class="admin-table-actions">
                          <button data-edit-article="${a.id}" class="btn-edit">Edit</button>
                          <button data-delete-article="${a.id}" class="btn-delete">Delete</button>
                        </td>
                      </tr>
                    `).join('')}
                  </tbody>
                </table>
              </div>
            </div>
          `;

          // Add search filter logic
          const searchInput = document.getElementById('articleSearch');

          if (searchInput) {
            searchInput.addEventListener('input', (e) => {
              const query = e.target.value.toLowerCase();

              document.querySelectorAll('tbody tr').forEach(row => {
                const text = row.innerText.toLowerCase();
                row.style.display = text.includes(query) ? '' : 'none';
              });
            });
          }

          // Expand preview
          document.querySelectorAll('[data-expand]').forEach(btn => {
            btn.addEventListener('click', () => {
              const id = btn.dataset.expand;
              const el = document.getElementById(`expand-${id}`);
              el.style.display = el.style.display === 'block' ? 'none' : 'block';
            });
          });

          // Delete
          document.querySelectorAll('[data-delete-article]').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              const id = e.target.dataset.deleteArticle;

              if (!confirm("Delete this article permanently?")) return;

              const { error } = await supabase
                .from('articles')
                .delete()
                .eq('id', id);

              if (error) {
                alert("Error deleting article.");
                console.error(error);
                return;
              }

              invalidateAdminData('articles');
              renderArticles();
            });
          });

          // Edit - Full Custom Modal
          document.querySelectorAll('[data-edit-article]').forEach(btn => {
            btn.addEventListener('click', async (e) => {
              const id = e.target.dataset.editArticle;

              const { data: article } = await supabase
                .from('articles')
                .select('*')
                .eq('id', id)
                .single();

              if (!article) {
                alert("Article not found.");
                return;
              }

              const modal = document.createElement('div');
              modal.style.position = 'fixed';
              modal.style.top = '0';
              modal.style.left = '0';
              modal.style.width = '100%';
              modal.style.height = '100%';
              modal.style.background = 'rgba(0,0,0,0.6)';
              modal.style.display = 'flex';
              modal.style.alignItems = 'center';
              modal.style.justifyContent = 'center';
              modal.style.zIndex = '99999';

              const formFields = Object.entries(article).map(([key, value]) => {

                let displayValue = '';

                if (value === null || value === undefined) {
                  displayValue = '';
                } 
                else if (typeof value === 'object') {
                  // Properly format JSON fields like faq_data & data_highlights
                  displayValue = JSON.stringify(value, null, 2);
                } 
                else {
                  displayValue = value;
                }

                return `
                  <div style="margin-bottom:14px;">
                    <label style="font-weight:600;font-size:13px;display:block;margin-bottom:4px;">
                      ${key}
                    </label>
                    <textarea data-field="${key}"
                      style="width:100%;min-height:80px;padding:8px;border-radius:6px;border:1px solid #ddd;font-size:13px;font-family:monospace;">${displayValue}</textarea>
                  </div>
                `;
              }).join('');

              modal.innerHTML = `
                <div style="
                  background:white;
                  width:90%;
                  max-width:900px;
                  max-height:85vh;
                  overflow-y:auto;
                  padding:28px;
                  border-radius:16px;
                  box-shadow:0 30px 80px rgba(0,0,0,.3);
                ">
                  <h3 style="margin-top:0;">Edit Article</h3>
                  ${formFields}
                  <div style="margin-top:20px;display:flex;gap:12px;justify-content:flex-end;">
                    <button id="closeModal"
                      style="padding:10px 18px;border-radius:8px;border:1px solid #ccc;background:white;cursor:pointer;">
                      Cancel
                    </button>
                    <button id="saveModal"
                      style="padding:10px 20px;border-radius:8px;background:var(--amber);color:white;border:none;cursor:pointer;">
                      Save Changes
                    </button>
                  </div>
                </div>
              `;

              document.body.appendChild(modal);

              document.getElementById('closeModal').onclick = () => {
                modal.remove();
              };

              document.getElementById('saveModal').onclick = async () => {

            const updatedData = {};

modal.querySelectorAll('textarea').forEach(field => {
  const key = field.dataset.field;
  let value = field.value.trim();

  if (!value) return;

  // BOOLEAN FIELDS
  if (key === 'mission_test_pass' || key === 'compliance_reviewed') {
    const lower = value.toLowerCase();

    if (lower === 'true' || lower === 't' || lower === '1') value = true;
    else if (lower === 'false' || lower === 'f' || lower === '0') value = false;
    else {
      alert(`${key} must be true or false`);
      throw new Error("Invalid boolean");
    }
  }

  // NUMBER FIELD
  if (key === 'word_count') {
    const num = Number(value);
    if (isNaN(num)) {
      alert("word_count must be a number");
      throw new Error("Invalid number");
    }
    value = num;
  }

  // JSON FIELDS
  if (key === 'faq_data' || key === 'data_highlights') {
    try {
      value = JSON.parse(value);
    } catch {
      value = [{ note: value }];
    }
  }

  updatedData[key] = value;
});

                const { error } = await supabase
                  .from('articles')
                  .update(updatedData)
                  .eq('id', id);

                if (error) {
                  alert("Error updating article.");
                  console.error(error);
                  return;
                }

                modal.remove();
                invalidateAdminData('articles');
                renderArticles();
              };
            });
          });

          // ADD NEW ARTICLE (FULL DYNAMIC FORM)
          const addBtn = document.getElementById('addArticleBtn');
          if (addBtn) {
            addBtn.addEventListener('click', async () => {

              // Fetch one row just to get all column keys
              const { data: sample } = await supabase
                .from('articles')
                .select('*')
                .limit(1);

              if (!sample || sample.length === 0) {
                alert("No article schema found.");
                return;
              }

              const columns = Object.keys(sample[0]);

              const modal = document.createElement('div');
              modal.style.position = 'fixed';
              modal.style.top = '0';
              modal.style.left = '0';
              modal.style.width = '100%';
              modal.style.height = '100%';
              modal.style.background = 'rgba(0,0,0,0.6)';
              modal.style.display = 'flex';
              modal.style.alignItems = 'center';
              modal.style.justifyContent = 'center';
              modal.style.zIndex = '99999';

              const formFields = columns
                .filter(col => col !== 'id') // id auto generated
                .map(col => `
                  <div style="margin-bottom:14px;">
                    <label style="font-weight:600;font-size:13px;display:block;margin-bottom:4px;">
                      ${col}
                    </label>
                    <textarea data-field="${col}"
                      style="width:100%;min-height:80px;padding:8px;border-radius:6px;border:1px solid #ddd;font-size:13px;font-family:monospace;"></textarea>
                  </div>
                `).join('');

              modal.innerHTML = `
                <div style="
                  background:white;
                  width:90%;
                  max-width:900px;
                  max-height:85vh;
                  overflow-y:auto;
                  padding:28px;
                  border-radius:16px;
                  box-shadow:0 30px 80px rgba(0,0,0,.3);
                ">
                  <h3 style="margin-top:0;">Create New Article</h3>

                  ${formFields}

                  <div style="margin-top:20px;display:flex;gap:12px;justify-content:flex-end;">
                    <button id="closeNewModal"
                      style="padding:10px 18px;border-radius:8px;border:1px solid #ccc;background:white;cursor:pointer;">
                      Cancel
                    </button>
                    <button id="saveNewArticle"
                      style="padding:10px 20px;border-radius:8px;background:var(--amber);color:white;border:none;cursor:pointer;">
                      Save Article
                    </button>
                  </div>
                </div>
              `;

              document.body.appendChild(modal);

              document.getElementById('closeNewModal').onclick = () => {
                modal.remove();
              };

              document.getElementById('saveNewArticle').onclick = async () => {

                const newArticle = {};

               modal.querySelectorAll('textarea').forEach(field => {
  const key = field.dataset.field;
  let value = field.value.trim();

  if (!value) return;

  // BOOLEAN FIELDS
  if (key === 'mission_test_pass' || key === 'compliance_reviewed') {
    const lower = value.toLowerCase();

    if (lower === 'true' || lower === 't' || lower === '1') value = true;
    else if (lower === 'false' || lower === 'f' || lower === '0') value = false;
    else {
      alert(`${key} must be true or false`);
      throw new Error("Invalid boolean");
    }
  }

  // NUMBER FIELD
  if (key === 'word_count') {
    const num = Number(value);
    if (isNaN(num)) {
      alert("word_count must be a number");
      throw new Error("Invalid number");
    }
    value = num;
  }

  // JSON FIELDS
  if (key === 'faq_data' || key === 'data_highlights') {
    try {
      value = JSON.parse(value);
    } catch {
      value = [{ note: value }];
    }
  }

  newArticle[key] = value;
});

                const { error } = await supabase
                  .from('articles')
                  .insert(newArticle);

                if (error) {
                  alert("Error creating article.");
                  console.error(error);
                  return;
                }

                modal.remove();
                invalidateAdminData('articles');
                renderArticles();
              };

            });
          }
        }

        // Tab click handler (SAFE RESET)
        const tabs = document.querySelectorAll('.tab')

        // Default load
        if (profile.role === 'admin') {
          renderUsers()
          prefetchAdminTabs()
        } else if (profile.role === 'referral') {
          renderAssignedMembers()
        }

        tabs.forEach(tab => {
          tab.addEventListener('click', () => {
            tabs.forEach(t => t.classList.remove('active'))
            tab.classList.add('active')

            const type = tab.dataset.tab

            if (type === 'users') renderUsers()
            if (type === 'admin-profile') renderAdminProfile()
            if (type === 'tasks') renderActionTasks()
            if (type === 'add-users') renderAddUsers()
            if (type === 'assign-referrals') renderAssignReferrals()
            if (type === 'assigned-members') renderAssignedMembers()
            if (type === 'team-members') renderTeamMembers()
            if (type === 'notifications') renderNotificationsAdmin()
            if (type === 'traffic') renderTraffic()
            if (type === 'articles') renderArticles()
          })
        })
      }
    }
  </script>

