            const category = toolCategoryFilter?.value || ''
            let visibleCount = 0

            toolCards.forEach(card => {
              const matchesQuery = !query || (card.dataset.toolSearch || '').toLowerCase().includes(query)
              const matchesCategory = !category || card.dataset.toolCategory === category
              const visible = matchesQuery && matchesCategory
              card.style.display = visible ? '' : 'none'
              if (visible) visibleCount += 1
            })

            if (toolSearchEmpty) toolSearchEmpty.style.display = visibleCount === 0 ? '' : 'none'
          }

