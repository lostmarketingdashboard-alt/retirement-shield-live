                    <button id="saveAssign" class="view-pdf-btn" type="button">Save Assignments</button>
                  </div>
                </div>
              `;

              document.body.appendChild(popup);

              document.getElementById('closeAssign').onclick = () => popup.remove();

              document.getElementById('saveAssign').onclick = async () => {
                // First delete all existing assignments for this referral
                await supabase
                  .from('referral_assignments')
                  .delete()
                  .eq('referral_id', referralId);

                // Then insert fresh selection
                const selected = popup.querySelectorAll('input:checked');

                const newAssignments = Array.from(selected).map(cb => ({
                  referral_id: referralId,
                  user_id: cb.value
                }));
                const selectedIds = newAssignments.map(assignment => assignment.user_id);
                const newlyAssignedIds = selectedIds.filter(userId => !assignedIds.includes(userId));

                if (newAssignments.length) {
                  await supabase
                    .from('referral_assignments')
                    .insert(newAssignments);
                }

                if (newlyAssignedIds.length) {
                  const referralName = referral?.full_name || 'your Retirement Shield consultant';
                  const assignmentNotifications = newlyAssignedIds.map(userId => ({
                    title: 'Consultant assigned',
                    body: `${referralName} has been assigned as a point of contact for your Retirement Shield plan.`,
                    audience: 'user',
                    recipient_user_id: userId,
                    send_at: null,
                    repeat_interval: 'none',
                    active: true,
                    created_by: user.id
                  }));

                  const { error: notificationError } = await supabase
                    .from('portal_notifications')
                    .insert(assignmentNotifications);

                  if (notificationError) {
                    console.error(notificationError);
                    alert('Assignments were saved, but user notifications could not be sent.');
                  }
                }

                invalidateAdminData('assignmentRows', 'notifications');
                popup.remove();
                renderAssignReferrals();
              };
            });
          });
        }

