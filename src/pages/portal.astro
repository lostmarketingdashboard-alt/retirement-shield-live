        async function renderTeam() {
          if (!userTabCache.team) {
            renderTabLoading('Loading your team...');
          }

          const { assignments, consultants } = await getTeamSnapshot();

          if (!assignments || assignments.length === 0) {
            contentDiv.innerHTML = `
              <div class="empty-state-card">
                <div class="doc-header">
                  <div class="doc-icon">RS</div>
                  <div>
                    <h3>Your Consultant</h3>
                    <div class="doc-meta">Primary point of contact</div>
                  </div>
                </div>
                <div class="doc-body">
                  <p>
                    No consultant has been assigned to your plan yet.
                    Once a consultant is formally connected to your strategy,
                    their details will appear here.
                  </p>
                  <button id="requestAssignmentBtn" class="portal-secondary-btn" type="button">Request assignment</button>
                </div>
              </div>
            `;
            document.getElementById('requestAssignmentBtn')?.addEventListener('click', (event) => {
              requestConsultantAssignment(event.currentTarget);
            });
            return;
          }

          const consultantCards = (consultants || []).map(c => {
            const emailAddress = getMailtoAddress(c.email);

            return `
              <div class="consultant-card">
                <div>
                  <strong>${escapeHtml(c.full_name ?? 'Your Consultant')}</strong>
                  <div class="consultant-email-value ${emailAddress ? 'is-hidden' : ''}" data-consultant-email-display="${escapeHtml(emailAddress)}">${escapeHtml(emailAddress ? 'Click Email to reveal address' : 'No email on file')}</div>
                </div>
                ${emailAddress ? `
                  <button class="consultant-email-btn" type="button" data-consultant-email-copy="${escapeHtml(emailAddress)}" aria-label="Reveal and copy ${escapeHtml(c.full_name ?? 'consultant')} email address">
                    <span class="consultant-email-icon" aria-hidden="true">
                      <svg viewBox="0 0 24 24"><path d="M4 7h16v10H4z"/><path d="m4 8 8 6 8-6"/></svg>
                    </span>
                    <span>Email</span>
                  </button>
                ` : ''}
              </div>
            `;
          }).join('');

          contentDiv.innerHTML = `
            <div class="doc-card">
              <div class="doc-header">
                <div class="doc-icon tools-main-icon">${renderToolIcon('shield')}</div>
                <div>
                  <h3>Your Consultant${consultants && consultants.length > 1 ? 's' : ''}</h3>
                  <div class="doc-meta">Primary point${consultants && consultants.length > 1 ? 's' : ''} of contact</div>
                </div>
              </div>
              <div class="doc-body">
                ${consultantCards}
              </div>
            </div>
          `;

          document.querySelectorAll('[data-consultant-email-copy]').forEach(button => {
            button.addEventListener('click', async () => {
              const emailAddress = getMailtoAddress(button.dataset.consultantEmailCopy);
              const emailDisplay = button.closest('.consultant-card')?.querySelector('[data-consultant-email-display]');

              if (emailDisplay && emailAddress) {
                emailDisplay.textContent = emailAddress;
                emailDisplay.classList.remove('is-hidden');
              }

              try {
                const copied = await copyTextToClipboard(emailAddress);
                showPortalStatusToast(copied ? 'Email copied' : 'Email revealed', copied ? `${emailAddress} copied to clipboard.` : `${emailAddress} is ready to copy.`);
              } catch (error) {
                console.error('Clipboard copy failed:', error);
                showPortalStatusToast('Email revealed', `${emailAddress} is ready to copy.`);
              }
            });
          });
        }

        function renderTimeline() {
          const stats = calculateStats();
          const milestones = [
            {
              label: 'Foundation',
              status: stats.completed > 0 ? 'complete' : 'progress',
              copy: stats.completed > 0 ? 'At least one action area has been completed.' : 'Start with the first action item in your plan.'
            },
            {
              label: 'Implementation',
              status: stats.inProgress > 0 ? 'progress' : stats.completed === stats.totalPlanItems && stats.totalPlanItems ? 'complete' : 'queued',
              copy: stats.inProgress > 0 ? 'You have active tasks underway.' : 'This begins once a checklist item is marked in progress.'
            },
            {
              label: 'Review',
              status: stats.percent >= 100 ? 'progress' : 'queued',
              copy: stats.percent >= 100 ? 'Your plan is ready for a review conversation.' : 'Review timing becomes useful after the plan is mostly complete.'
            }
          ];

          contentDiv.innerHTML = `
            <div class="timeline-layout">
              <div class="timeline-head">
