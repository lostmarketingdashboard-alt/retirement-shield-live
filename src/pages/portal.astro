---
export const prerender = false;
export const ssr = false;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Client Portal</title>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@400;600;700&family=DM+Sans:wght@300;400;500;600;700&display=swap" rel="stylesheet">
</head>

<body>
  <div id="app"></div>

  <script type="module">
    import { createClient } from 'https://esm.sh/@supabase/supabase-js@2'

    const supabase = createClient(
      "https://nyiturqeotdxucfdurzu.supabase.co",
      "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Im55aXR1cnFlb3RkeHVjZmR1cnp1Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzIxMzI0ODgsImV4cCI6MjA4NzcwODQ4OH0.CvYju6UTaCGD_Zd-8FVTcB-yW9YVG_jQtwkd0l7mIV0",
      {
        auth: {
          persistSession: true,
          autoRefreshToken: true,
          detectSessionInUrl: true,
          flowType: 'pkce'
        }
      }
    )

    document.addEventListener('DOMContentLoaded', async () => {
      const { data: { session } } = await supabase.auth.getSession()

      if (!session || !session.user) {
        window.location.href = '/login'
        return
      }

      const user = session.user

      const { data: profile, error } = await supabase
        .from('profiles')
        .select('*')
        .eq('id', user.id)
        .single()

      if (error || !profile) {
        window.location.href = '/login'
        return
      }

      if (profile.role === 'user' && !profile.paid) {
        await supabase.auth.signOut()
        window.location.href = '/login?payment=required'
        return
      }

      initializePortal(user, profile)
    })

    function initializePortal(user, profile) {
      const getInitials = (name) => name
        ? name.split(' ').map(n => n[0]).join('').slice(0,2).toUpperCase()
        : 'RS'

      const getFamilyPlanTitle = (name) => name
        ? `${name.split(' ').slice(-1)[0]} Family Plan`
        : 'Your Family Plan'

      const getPortalStateLabel = (value) => value || 'Not added yet'
      const getProfileEmail = () => profile.email || user.email || ''
      const escapeHtml = (value = '') => String(value)
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#039;')
      const initials = getInitials(profile.full_name)
      let notificationToastTimer = null;
      let portalStatusToastTimer = null;
      const PORTAL_CONTACT_EMAIL = 'info@retirementshield.io';
      const PORTAL_ASSISTANT_TOOLS = [
        { title: 'Family Plan Quiz', href: () => `/family-plan-quiz?utm=${user.id}`, keywords: ['family plan', 'family quiz', 'household', 'adult children', 'parents'] },
        { title: "Widow's Playbook", href: () => `/widows-playbook?utm=${user.id}`, keywords: ['widow', 'widows', 'surviving spouse', 'spouse dies', 'survivor'] },
        { title: 'Home Equity Intelligence Report', href: () => `/home-equity?utm=${user.id}`, keywords: ['home equity', 'house', 'property', 'home value', 'real estate'] },
        { title: 'Emergency Binder Generator', href: () => `/emergency-binder-generator?utm=${user.id}`, keywords: ['binder', 'emergency binder', 'after i am gone', 'documents'] },
        { title: 'Retirement Paycheck', href: () => `/retirement-paycheck?utm=${user.id}`, keywords: ['paycheck', 'dividend income', 'retirement income', 'income report'] },
        { title: 'Retirement Runway', href: () => `/retirement-runway?utm=${user.id}`, keywords: ['runway', 'money lasts', 'savings last', 'how long money'] },
        { title: 'Income Shield', href: () => `/income-shield-test?utm=${user.id}`, keywords: ['income shield', 'stress test', 'cash flow', 'market crash'] },
        { title: 'Inflation Erosion Visualizer', href: () => `/inflation-erosion-visualizer?utm=${user.id}`, keywords: ['inflation', 'purchasing power', 'erosion'] },
        { title: 'IRMAA Guard', href: () => `/irmaa-guard?utm=${user.id}`, keywords: ['irmaa', 'medicare', 'surcharge', 'part b', 'part d'] },
        { title: 'RMD Calendar + Tax Impact Estimator', href: () => `/rmd-calendar-tax-estimator?utm=${user.id}`, keywords: ['rmd', 'required minimum', 'ira withdrawal', 'tax impact'] },
        { title: 'Annuity X-Ray Report', href: () => `/annuity-x-ray-report?utm=${user.id}`, keywords: ['annuity', 'x ray', 'surrender', 'fees'] },
        { title: 'Unclaimed Property Finder', href: () => `/unclaimed-property-finder?utm=${user.id}`, keywords: ['unclaimed', 'lost money', 'property finder'] },
        { title: 'Retirement Relocation Calculator', href: () => `/retirement-relocation-calculator?utm=${user.id}`, keywords: ['relocation', 'move', 'retire somewhere', 'should i move'] },
        { title: 'Inheritance Collision Report', href: () => `/inheritance-collision-report?utm=${user.id}`, keywords: ['inheritance', 'collision', 'blended family', 'stepchildren'] },
        { title: '72-Hour Checklist', href: () => `/72-hour-checklist?utm=${user.id}`, keywords: ['72 hour', 'after death', 'checklist', 'death checklist'] },
        { title: 'Shield Brief', href: () => `/shield-brief?utm=${user.id}`, keywords: ['shield brief', 'monthly brief', 'monthly report'] },
        { title: 'Dividend Watch', href: () => `/dividend-watch?utm=${user.id}`, keywords: ['dividend watch', 'dividend alerts', 'portfolio monitor'] },
        { title: 'Estate Watch', href: () => `/estate-watch?utm=${user.id}`, keywords: ['estate watch', 'law change', 'state law', 'plan review'] }
      ];

      function showNotificationToast(count) {
        if (!['user', 'admin'].includes(profile.role)) return;
        if (!count || count < 1) return;

        const existingToast = document.getElementById('notificationToast');
        if (existingToast) existingToast.remove();
        if (notificationToastTimer) window.clearTimeout(notificationToastTimer);

        const toast = document.createElement('div');
        toast.id = 'notificationToast';
        toast.className = 'notification-toast';
        toast.innerHTML = `
          <button class="notification-toast-close" type="button" aria-label="Dismiss notification popup">×</button>
          <div class="notification-toast-title">New messages</div>
          <div class="notification-toast-copy">You have ${count} new message${count === 1 ? '' : 's'}.</div>
        `;

        document.body.appendChild(toast);
        window.requestAnimationFrame(() => toast.classList.add('show'));

        const closeToast = () => {
          toast.classList.remove('show');
          window.setTimeout(() => toast.remove(), 220);
        };

        toast.addEventListener('click', (event) => {
          if (event.target.closest('.notification-toast-close')) {
            closeToast();
            return;
          }

          const notificationDrawer = document.getElementById('notificationDrawer');
          if (notificationDrawer) {
            notificationDrawer.classList.add('open');
            notificationDrawer.setAttribute('aria-hidden', 'false');
          }
          closeToast();
        });

        notificationToastTimer = window.setTimeout(closeToast, 5200);
      }

      function showPortalStatusToast(title, copy) {
        const existingToast = document.getElementById('portalStatusToast');
        if (existingToast) existingToast.remove();
        if (portalStatusToastTimer) window.clearTimeout(portalStatusToastTimer);

        const toast = document.createElement('div');
        toast.id = 'portalStatusToast';
        toast.className = 'notification-toast';
        toast.innerHTML = `
          <button class="notification-toast-close" type="button" aria-label="Dismiss status popup">×</button>
          <div class="notification-toast-title">${escapeHtml(title)}</div>
          <div class="notification-toast-copy">${escapeHtml(copy)}</div>
        `;

        document.body.appendChild(toast);
        window.requestAnimationFrame(() => toast.classList.add('show'));

        const closeToast = () => {
          toast.classList.remove('show');
          window.setTimeout(() => toast.remove(), 220);
        };

        toast.addEventListener('click', closeToast);
        portalStatusToastTimer = window.setTimeout(closeToast, 3200);
      }

      const app = document.getElementById('app')

      app.innerHTML = `
        <div class="portal-root">

          <nav class="portal-nav">
            <div class="nav-left" onclick="window.location.href='/'">
              <div class="shield-icon"></div>
              <span class="brand">Retirement <span>Shield</span></span>
            </div>

            <div class="nav-right">
              <span class="badge">${profile.role.toUpperCase()} PORTAL</span>

              ${['user', 'admin'].includes(profile.role) ? `
                <button id="notificationBtn" class="notification-btn" type="button" aria-label="Open notifications">
                  <span class="notification-symbol">!</span>
                  <span id="notificationCount" class="notification-count">0</span>
                </button>
              ` : ''}

              <div class="user-menu">
                <div class="avatar">${initials}</div>
                <div class="user-info">
                  <span class="user-name" id="portalUserName">${profile.full_name}</span>
                  <span class="user-role">${profile.role}</span>
                </div>
                <button id="logoutBtn" class="logout-btn">Sign Out</button>
              </div>
            </div>
          </nav>
 ${profile.role === 'user' ? `
          <section class="hero">
            <div class="hero-inner">
              <div class="hero-label">
                <span class="line"></span>
                Your Retirement Action Plan
              </div>

              <div class="hero-card">
                  <div class="progress-wrap">
                  <div class="progress-ring" id="portalProgressRing">
                    <div class="progress-value" id="portalProgressValue">0%</div>
                    <div class="progress-label">Complete</div>
                  </div>
                </div>
  
                <div class="hero-main">
                  <h1 id="portalFamilyPlanTitle">${getFamilyPlanTitle(profile.full_name)}</h1>
                  <p class="subtext" id="portalHeroSubtext">Loading your retirement action plan...</p>

               
                  <div class="status-badges">
                    <span class="badge-complete">0 Completed</span>
                    <span class="badge-progress">0 In Progress</span>
                    <span class="badge-queued">0 Queued</span>
                  </div>
              
                </div>

                <div class="review-box">
                  <div class="review-label">Next Plan Review</div>
                  <div class="review-date" id="portalReviewDate">Schedule</div>
                  <div class="review-sub" id="portalReviewSub">Ask your team to set a review date</div>
                </div>
              </div>
            </div>
          </section>
    ` : ''}
          <div class="tabs-wrap">
            <button class="tab-scroll-btn tab-scroll-left" type="button" data-tab-scroll="left" aria-label="Scroll tabs left">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M14.5 6.5 9 12l5.5 5.5"/></svg>
            </button>
            <div class="tabs">
              ${profile.role === 'admin' ? `
  <button class="tab active" data-tab="users">Users</button>
  <button class="tab" data-tab="admin-profile">My Profile</button>
  <button class="tab" data-tab="tasks">Action Tasks</button>
  <button class="tab" data-tab="add-users">Add Users</button>
  <button class="tab" data-tab="assign-referrals">Assign Referral Members</button>
  <button class="tab" data-tab="team-members">Team Members</button>
  <button class="tab" data-tab="notifications">Notifications</button>
  <button class="tab" data-tab="traffic">Traffic</button>
  <button class="tab" data-tab="articles">Articles</button>
` : profile.role === 'referral' ? `
  <button class="tab active" data-tab="assigned-members">Assigned Members</button>
` : `
  <button class="tab active" data-tab="action">Action Plan</button>
 
  <button class="tab" data-tab="documents">Documents</button>
  <button class="tab" data-tab="tools">Tools</button>
   <button class="tab" data-tab="profile">Profile</button>
  <button class="tab" data-tab="team">Your Team</button>
  <button class="tab" data-tab="timeline">Timeline</button>
`}
            </div>
            <button class="tab-scroll-btn tab-scroll-right" type="button" data-tab-scroll="right" aria-label="Scroll tabs right">
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m9.5 6.5 5.5 5.5-5.5 5.5"/></svg>
            </button>
            <div class="tab-underline"></div>
          </div>

          <div class="content-wrap">
            <div id="portalContent"></div>
          </div>

          ${['user', 'admin'].includes(profile.role) ? `
            <div id="notificationDrawer" class="notification-drawer" aria-hidden="true">
              <div class="notification-panel">
                <div class="notification-panel-head">
                  <div>
                    <div class="section-kicker">Notifications</div>
                    <h3>Messages</h3>
                  </div>
                  <button id="closeNotificationDrawer" class="notification-close" type="button">Close</button>
                </div>
                <div id="notificationList" class="notification-list">
                  <div class="notification-empty">Loading notifications...</div>
                </div>
              </div>
            </div>
          ` : ''}

          <div class="assistant-shell" id="assistantShell">
            <div class="assistant-nudge" id="assistantNudge">Need a tool or contact info? Ask me.</div>
            <div class="assistant-panel" id="assistantPanel" aria-live="polite">
              <div class="assistant-header">
                <div>
                  <div class="assistant-kicker">Retirement Shield AI</div>
                  <div class="assistant-title">Your portal helper.</div>
                </div>
                <button class="assistant-close" type="button" id="assistantClose" aria-label="Close assistant">×</button>
              </div>
              <div class="assistant-messages" id="assistantMessages"></div>
              <div class="assistant-prompts" id="assistantPrompts"></div>
              <div class="assistant-status" id="assistantStatus">Can launch tools, find reports, and share contact details.</div>
              <form class="assistant-form" id="assistantForm">
                <input id="assistantInput" type="text" autocomplete="off" placeholder="Ask for a tool, contact, or your profile info..." />
                <button type="submit">Ask</button>
              </form>
            </div>
            <button class="assistant-launcher" id="assistantLauncher" type="button" aria-label="Open Retirement Shield AI assistant" aria-expanded="false">
              <span class="assistant-launcher-mark">
                <i class="assistant-chat-dot" aria-hidden="true"></i>
              </span>
              <span class="assistant-launcher-label"> </span>
            </button>
          </div>

          <footer class="portal-footer">
            © 2026 <strong>Retirement Shield</strong> · Educational use only
          </footer>

        </div>
      `

      document.getElementById('logoutBtn').addEventListener('click', async () => {
        await supabase.auth.signOut()
        window.location.href = '/'
      })

      const contentDiv = document.getElementById('portalContent')
      const tabsWrap = document.querySelector('.tabs-wrap');
      const tabsScroller = document.querySelector('.tabs');
      const updateTabScrollState = () => {
        if (!tabsWrap || !tabsScroller) return;
        const canScroll = tabsScroller.scrollWidth > tabsScroller.clientWidth + 2;
        const atStart = tabsScroller.scrollLeft <= 2;
        const atEnd = tabsScroller.scrollLeft + tabsScroller.clientWidth >= tabsScroller.scrollWidth - 2;
        tabsWrap.classList.toggle('is-scrollable', canScroll);
        tabsWrap.classList.toggle('at-start', !canScroll || atStart);
        tabsWrap.classList.toggle('at-end', !canScroll || atEnd);
      };

      tabsScroller?.addEventListener('scroll', updateTabScrollState, { passive: true });
      window.addEventListener('resize', updateTabScrollState);
      document.querySelectorAll('[data-tab-scroll]').forEach(btn => {
        btn.addEventListener('click', () => {
          const direction = btn.dataset.tabScroll === 'left' ? -1 : 1;
          tabsScroller?.scrollBy({ left: direction * 220, behavior: 'smooth' });
        });
      });
      window.setTimeout(updateTabScrollState, 80);
      const assistantShell = document.getElementById('assistantShell');
      const assistantLauncher = document.getElementById('assistantLauncher');
      const assistantClose = document.getElementById('assistantClose');
      const assistantMessages = document.getElementById('assistantMessages');
      const assistantPrompts = document.getElementById('assistantPrompts');
      const assistantStatus = document.getElementById('assistantStatus');
      const assistantForm = document.getElementById('assistantForm');
      const assistantInput = document.getElementById('assistantInput');
      const assistantNudge = document.getElementById('assistantNudge');
      let assistantContext = {};

      function assistantNormalize(value) {
        return String(value || '')
          .toLowerCase()
          .replace(/&/g, ' and ')
          .replace(/[^a-z0-9\s]/g, ' ')
          .replace(/\s+/g, ' ')
          .trim();
      }

      function setAssistantOpen(isOpen) {
        if (!assistantShell) return;
        assistantShell.classList.toggle('open', isOpen);
        assistantLauncher?.setAttribute('aria-expanded', String(isOpen));
        assistantNudge?.classList.remove('visible');
        if (isOpen) window.setTimeout(() => assistantInput?.focus(), 80);
      }

      function renderAssistantPrompts(prompts = []) {
        if (!assistantPrompts) return;
        assistantPrompts.innerHTML = prompts.map(prompt => `
          <button type="button" data-assistant-prompt="${escapeHtml(prompt)}">${escapeHtml(prompt)}</button>
        `).join('');
      }

      function appendAssistantMessage(role, text, links = []) {
        if (!assistantMessages) return;
        const bubble = document.createElement('div');
        bubble.className = `assistant-message ${role}`;
        bubble.innerHTML = `
          <div>${escapeHtml(text)}</div>
          ${links.length ? `
            <div class="assistant-links">
              ${links.map(link => `<a href="${escapeHtml(link.href)}">${escapeHtml(link.label)}</a>`).join('')}
            </div>
          ` : ''}
        `;
        assistantMessages.appendChild(bubble);
        assistantMessages.scrollTop = assistantMessages.scrollHeight;
      }

      function findPortalToolMatches(message) {
        const normalized = assistantNormalize(message);
        return PORTAL_ASSISTANT_TOOLS
          .map(tool => {
            const title = assistantNormalize(tool.title);
            const keywordHit = tool.keywords.some(keyword => normalized.includes(assistantNormalize(keyword)));
            const titleTokens = title.split(' ').filter(token => token.length > 2);
            const tokenScore = titleTokens.reduce((sum, token) => sum + (normalized.includes(token) ? 1 : 0), 0);
            return { tool, score: (keywordHit ? 10 : 0) + tokenScore };
          })
          .filter(match => match.score > 0)
          .sort((a, b) => b.score - a.score)
          .slice(0, 4)
          .map(match => match.tool);
      }

      function activatePortalTab(tabName) {
        const tab = document.querySelector(`.tab[data-tab="${tabName}"]`);
        if (!tab) return false;
        tab.click();
        return true;
      }

      function getPortalInfoSummary() {
        const details = [
          `Name: ${profile.full_name || 'not added yet'}`,
          `Email: ${getProfileEmail() || 'not added yet'}`,
          `State: ${profile.state || 'not added yet'}`,
          `County: ${profile.county || 'not added yet'}`
        ];
        return `Here is the portal profile information I can see: ${details.join('. ')}. You can update this in Profile, and onboarding quiz answers live there too.`;
      }

      function handlePortalAssistantShortcut(message) {
        const normalized = assistantNormalize(message);
        const wantsLaunch = /\b(open|launch|start|go to|take me|run|use)\b/.test(normalized);

        if (/\b(contact|support|help desk|email|phone|reach someone|talk to someone)\b/.test(normalized)) {
          return {
            reply: `You can contact Retirement Shield at ${PORTAL_CONTACT_EMAIL}. I can also help route you to your Team tab if you want consultant details.`,
            links: [
              { label: 'Email Retirement Shield', href: `mailto:${PORTAL_CONTACT_EMAIL}` },
              { label: 'Open Your Team', href: '#team' }
            ],
            prompts: ['Open my team', 'Show my profile information']
          };
        }

        if (/\b(my info|my information|profile|state|county|onboarding|quiz answers|answers)\b/.test(normalized)) {
          return {
            reply: getPortalInfoSummary(),
            links: [{ label: 'Open Profile', href: '#profile' }],
            prompts: ['Open my profile', 'Where are my documents?']
          };
        }

        if (/\b(document|documents|report|reports|pdf|saved work)\b/.test(normalized)) {
          return {
            reply: 'Your saved reports and generated PDFs live in Documents. I can open that section for you.',
            links: [{ label: 'Open Documents', href: '#documents' }],
            prompts: ['Show tools', 'Open my profile']
          };
        }

        if (/\b(team|consultant|advisor|referral member)\b/.test(normalized)) {
          return {
            reply: 'Your consultant details live in Your Team. If no consultant is assigned yet, you can request one there.',
            links: [{ label: 'Open Your Team', href: '#team' }],
            prompts: ['Contact support', 'Open action plan']
          };
        }

        if (/\b(action plan|tasks|checklist|progress|timeline)\b/.test(normalized)) {
          return {
            reply: 'Your action items are in Action Plan, and the Timeline tab shows the implementation path.',
            links: [
              { label: 'Open Action Plan', href: '#action' },
              { label: 'Open Timeline', href: '#timeline' }
            ],
            prompts: ['Show documents', 'Show tools']
          };
        }

        const toolMatches = findPortalToolMatches(message);
        if (toolMatches.length) {
          const links = toolMatches.map(tool => ({ label: tool.title, href: tool.href() }));
          if (wantsLaunch && toolMatches.length === 1) {
            return {
              reply: `Opening ${toolMatches[0].title} now.`,
              links,
              redirect: toolMatches[0].href(),
              prompts: ['Show all tools', 'Open documents']
            };
          }

          return {
            reply: toolMatches.length === 1
              ? `${toolMatches[0].title} is the closest match. Use the link below to launch it.`
              : 'These portal tools match what you asked for.',
            links,
            prompts: ['Open Documents', 'Contact support']
          };
        }

        if (/\b(all tools|show tools|tools|what can i do)\b/.test(normalized)) {
          return {
            reply: 'The Tools tab has the full Retirement Shield tool library. I can also launch a specific one if you name it.',
            links: [
              { label: 'Open Tools Tab', href: '#tools' },
              ...PORTAL_ASSISTANT_TOOLS.slice(0, 3).map(tool => ({ label: tool.title, href: tool.href() }))
            ],
            prompts: ['Launch IRMAA Guard', 'Open Home Equity', 'Open Emergency Binder']
          };
        }

        return null;
      }

      async function askAssistant(message) {
        const cleanMessage = String(message || '').trim();
        if (!cleanMessage) return;

        appendAssistantMessage('user', cleanMessage);
        if (assistantInput) assistantInput.value = '';
        if (assistantStatus) assistantStatus.textContent = 'Checking portal context...';

        const localAnswer = handlePortalAssistantShortcut(cleanMessage);
        if (localAnswer) {
          appendAssistantMessage('bot', localAnswer.reply, localAnswer.links || []);
          renderAssistantPrompts(localAnswer.prompts || []);
          if (assistantStatus) assistantStatus.textContent = 'Ready to launch tools and route portal sections.';
          if (localAnswer.redirect) window.setTimeout(() => { window.location.href = localAnswer.redirect; }, 650);
          return;
        }

        try {
          const response = await fetch('/api/assistant/chat', {
            method: 'POST',
            headers: { 'content-type': 'application/json' },
            body: JSON.stringify({
              message: cleanMessage,
              context: {
                ...assistantContext,
                portal: true,
                stateName: profile.state || assistantContext.stateName,
                countyName: profile.county || assistantContext.countyName
              }
            })
          });
          const data = await response.json();
          assistantContext = data.context || assistantContext || {};
          appendAssistantMessage('bot', data.reply || 'I found a few places to start.', data.links || []);
          renderAssistantPrompts(data.prompts || ['Show tools', 'Contact support']);
          if (assistantStatus) assistantStatus.textContent = response.ok ? 'Uses Retirement Shield pages and portal context.' : 'Try a different tool, state, or county.';
        } catch (error) {
          console.error('Assistant request failed:', error);
          appendAssistantMessage('bot', `I had trouble reaching the assistant. You can always contact ${PORTAL_CONTACT_EMAIL}.`, [
            { label: 'Email Retirement Shield', href: `mailto:${PORTAL_CONTACT_EMAIL}` }
          ]);
          if (assistantStatus) assistantStatus.textContent = 'Connection issue.';
        }
      }

      assistantLauncher?.addEventListener('click', () => setAssistantOpen(!assistantShell?.classList.contains('open')));
      assistantClose?.addEventListener('click', () => setAssistantOpen(false));
      assistantForm?.addEventListener('submit', (event) => {
        event.preventDefault();
        askAssistant(assistantInput?.value);
      });
      assistantPrompts?.addEventListener('click', (event) => {
        const target = event.target.closest('[data-assistant-prompt]');
        if (target) askAssistant(target.dataset.assistantPrompt);
      });
      assistantMessages?.addEventListener('click', (event) => {
