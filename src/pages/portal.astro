  }

  .profile-pill {
    width: 100%;
    justify-content: center;
    text-align: center;
    box-sizing: border-box;
  }

  .profile-identity-card {
    align-items: flex-start;
    text-align: left;
    padding: 18px;
    width: 100%;
  }

  .profile-avatar-lg {
    margin-bottom: 14px;
    width: 74px;
    height: 74px;
    font-size: 24px;
  }

  .profile-identity-name {
    font-size: 22px;
  }

  .profile-grid {
    gap: 18px;
    width: 100%;
    min-width: 0;
  }

  .profile-card-head {
    margin-bottom: 18px;
  }

  .profile-form {
    gap: 16px;
  }

  .profile-form-grid {
    gap: 14px;
    width: 100%;
  }

  .profile-label {
    font-size: 10px;
  }

  .profile-input {
    min-height: 48px;
    font-size: 16px;
    padding: 14px 15px;
    width: 100%;
    max-width: 100%;
  }

  .profile-actions {
    width: 100%;
  }

  .profile-actions .view-pdf-btn {
    width: 100%;
  }

  .profile-alert {
    padding: 13px 14px;
    margin-bottom: 16px;
    font-size: 13px;
  }

  .profile-usage-item {
    padding: 16px;
  }

  .profile-usage-item strong {
    font-size: 15px;
  }

  .profile-usage-item span {
    font-size: 13px;
  }

  .tools-body {
    padding-top: 0;
  }

  .tools-grid {
    grid-template-columns: 1fr;
    gap: 14px;
  }

  .tool-card {
    min-height: 0;
    padding: 16px;
    gap: 14px;
    border-radius: 16px;
  }

  .tool-card-top {
    gap: 12px;
  }

  .tool-card-head {
    flex-direction: column;
    align-items: flex-start;
    gap: 12px;
  }

  .tool-copy {
    width: 100%;
  }

  .tool-copy h4 {
    word-break: break-word;
    overflow-wrap: anywhere;
  }

  .tool-restart-btn {
    align-self: flex-start;
  }

  .tool-badge {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    flex: 0 0 52px;
  }

  .tool-badge svg {
    width: 26px;
    height: 26px;
  }

  .tool-copy h4 {
    font-size: 17px;
    line-height: 1.35;
    margin-bottom: 6px;
  }

  .tool-copy p {
    font-size: 13px;
    line-height: 1.55;
  }

  .launch-tool-btn {
    width: 100%;
    padding: 13px 16px;
    font-size: 13px;
    border-radius: 14px;
  }

  .tool-restart-btn {
    padding: 7px 12px;
    font-size: 11px;
    margin-left: 0;
  }

  /* ADMIN USERS */
  .user-row {
    flex-direction: column !important;
    align-items: flex-start !important;
    gap: 12px !important;
  }

  .role-select,
  .delete-user-btn {
    width: 100%;
  }

}

    :root {
      --navy: #0d1b2a;
      --navy-mid: #1a2e45;
      --navy-light: #243b55;
      --cream: #f5f0e8;
      --cream-dark: #ede6d6;
      --amber: #c8821a;
      --amber-light: #e8a840;
      --text-primary: #1a1208;
      --text-secondary: #4a3f32;
      --text-muted: #7a6e62;
      --white: #ffffff;
      --rule: #c8b89a;
      --rule-light: rgba(200,184,154,0.35);
    }

    body {
      margin: 0;
      font-family: 'DM Sans', sans-serif;
      background: var(--cream-dark);
      color: var(--text-primary);
      overflow-x: hidden;
    }

    /* NAV */

    .portal-nav {
      background: var(--navy);
      height: 72px;
      padding: 0 32px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      width: 100%;
      box-sizing: border-box;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 14px;
      cursor: pointer;
    }

    .nav-right {
      display: flex;
      align-items: center;
      gap: 18px;
      flex-shrink: 0;
    }

    .user-menu {
      display: flex;
      align-items: center;
      gap: 12px;
      padding: 6px 14px;
      background: rgba(255,255,255,0.06);
      border: 1px solid rgba(255,255,255,0.12);
      border-radius: 999px;
      transition: all .2s ease;
      max-width: 100%;
    }

    .user-menu:hover {
      background: rgba(255,255,255,0.08);
      border-color: var(--amber);
    }

    .badge {
      white-space: nowrap;
    }

    @media (max-width: 900px) {
      .badge {
        display: none;
      }

      .user-info {
        display: none;
      }

      .portal-nav {
        padding: 0 20px;
      }
    }

    .user-info {
      display: flex;
      flex-direction: column;
      line-height: 1.1;
    }

    .user-name {
      color: var(--white);
      font-size: 14px;
      font-weight: 500;
    }

    .user-role {
      font-size: 11px;
      color: var(--amber-light);
      text-transform: uppercase;
      letter-spacing: 1px;
    }

    .logout-btn {
      background: transparent;
      border: 1px solid rgba(255,255,255,0.2);
      color: rgba(255,255,255,0.8);
      padding: 6px 14px;
      border-radius: 20px;
      font-size: 12px;
      cursor: pointer;
      transition: all .2s ease;
    }

    .logout-btn:hover {
      border-color: var(--amber);
      color: var(--amber-light);
      background: rgba(200,130,26,.1);
    }

    .notification-btn {
      position: relative;
      width: 42px;
      height: 42px;
      border-radius: 50%;
      border: 1px solid rgba(255,255,255,.18);
      background: rgba(255,255,255,.06);
      color: var(--amber-light);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      transition: all .2s ease;
      flex-shrink: 0;
    }

    .notification-btn:hover,
    .notification-btn.has-notifications {
      border-color: var(--amber);
      background: rgba(200,130,26,.14);
    }

    .notification-symbol {
      font-size: 18px;
      line-height: 1;
    }

    .notification-count {
      position: absolute;
      top: -7px;
      right: -7px;
      min-width: 20px;
      height: 20px;
      border-radius: 999px;
      background: var(--amber);
      color: var(--white);
      border: 2px solid var(--navy);
      font-size: 11px;
      line-height: 16px;
      text-align: center;
      padding: 0 5px;
    }

    .notification-drawer {
      position: fixed;
      inset: 0;
      z-index: 9998;
      background: rgba(13,27,42,.46);
      display: none;
      justify-content: flex-end;
      padding: 18px;
    }

    .notification-drawer.open {
      display: flex;
    }

    .notification-panel {
      width: min(430px, 100%);
      height: 100%;
      max-height: 720px;
      background: var(--white);
      border: 1px solid var(--rule-light);
      border-radius: 22px;
      box-shadow: 0 30px 80px rgba(0,0,0,.28);
      padding: 24px;
      overflow-y: auto;
    }

    .notification-panel-head {
      display: flex;
      justify-content: space-between;
      gap: 16px;
      align-items: flex-start;
      margin-bottom: 18px;
    }

    .notification-panel-head h3 {
      margin: 0;
      font-family: 'Playfair Display', serif;
      color: var(--navy);
      font-size: 26px;
    }

    .notification-close,
    .notification-x {
      border: 1px solid var(--rule-light);
      background: rgba(245,240,232,.72);
      color: var(--navy);
      border-radius: 999px;
      cursor: pointer;
      font-weight: 800;
    }

    .notification-close {
      padding: 8px 12px;
      font-size: 12px;
    }

    .notification-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .notification-item {
      position: relative;
      border: 1px solid var(--rule-light);
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(255,255,255,.98) 0%, rgba(245,240,232,.62) 100%);
      padding: 16px 42px 16px 16px;
    }

    .notification-x {
      position: absolute;
      top: 12px;
      right: 12px;
      width: 26px;
      height: 26px;
      font-size: 18px;
      line-height: 1;
    }

    .notification-title {
      color: var(--navy);
      font-weight: 800;
      margin-bottom: 6px;
      line-height: 1.3;
    }

    .notification-item p,
    .notification-empty {
      color: var(--text-secondary);
      line-height: 1.6;
      margin: 0;
      font-size: 14px;
    }

    .notification-meta {
      margin-top: 10px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .7px;
      text-transform: uppercase;
    }

    .notification-toast {
      position: fixed;
      top: 22px;
      right: 22px;
      z-index: 10000;
      width: min(340px, calc(100vw - 32px));
      background: var(--white);
      border: 1px solid var(--rule-light);
      border-left: 4px solid var(--amber);
      border-radius: 16px;
      box-shadow: 0 24px 64px rgba(13,27,42,.22);
      padding: 16px 44px 16px 16px;
      opacity: 0;
      transform: translateY(-10px);
      transition: opacity .22s ease, transform .22s ease;
      cursor: pointer;
    }

    .notification-toast.show {
      opacity: 1;
      transform: translateY(0);
    }

    .notification-toast-title {
      color: var(--navy);
      font-weight: 800;
      font-size: 15px;
      margin-bottom: 4px;
    }

    .notification-toast-copy {
      color: var(--text-secondary);
      font-size: 14px;
      line-height: 1.5;
    }

    .notification-toast-close {
      position: absolute;
      top: 10px;
      right: 10px;
      width: 26px;
      height: 26px;
      border-radius: 999px;
      border: 1px solid var(--rule-light);
      background: rgba(245,240,232,.72);
      color: var(--navy);
      cursor: pointer;
      font-size: 18px;
      line-height: 1;
      font-weight: 800;
    }

    .assistant-shell {
      position: fixed;
      right: 24px;
      bottom: 24px;
      z-index: 9000;
      font-family: 'DM Sans', sans-serif;
    }

    .assistant-nudge {
      position: absolute;
      right: 78px;
      bottom: 10px;
      width: 240px;
      background: var(--white);
      border: 1px solid var(--rule-light);
      color: var(--text-secondary);
      padding: 12px 14px;
      border-radius: 14px;
      box-shadow: 0 18px 44px rgba(13,27,42,.18);
      font-size: 13px;
      line-height: 1.35;
      opacity: 0;
      transform: translateY(8px);
      pointer-events: none;
      transition: opacity .25s ease, transform .25s ease;
    }

    .assistant-nudge.visible {
      opacity: 1;
      transform: translateY(0);
    }

    .assistant-nudge::after {
      content: "";
      position: absolute;
      right: -7px;
      bottom: 20px;
      width: 12px;
      height: 12px;
      background: var(--white);
      border-right: 1px solid var(--rule-light);
      border-bottom: 1px solid var(--rule-light);
      transform: rotate(-45deg);
    }

    .assistant-launcher {
      width: 78px;
      height: 78px;
      border: 1px solid rgba(232,168,64,.82);
      border-radius: 50%;
      background:
        radial-gradient(circle at 34% 24%, rgba(232,168,64,.18), transparent 35%),
        linear-gradient(145deg, #10243a 0%, #071522 100%);
      color: var(--amber-light);
      display: grid;
      grid-template-rows: 1fr auto;
      align-items: center;
      justify-items: center;
      padding: 13px 10px 11px;
      cursor: pointer;
      box-shadow: 0 18px 46px rgba(13,27,42,.34), inset 0 0 0 7px rgba(245,240,232,.035), 0 0 0 6px rgba(200,130,26,.08);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    .assistant-launcher:hover {
      transform: translateY(-2px);
      box-shadow: 0 22px 54px rgba(13,27,42,.4), inset 0 0 0 7px rgba(245,240,232,.045), 0 0 0 8px rgba(200,130,26,.1);
    }

    .assistant-launcher-mark {
      width: 39px;
      height: 31px;
      display: flex;
      align-items: center;
      justify-content: center;
      position: relative;
      border: 2px solid var(--amber-light);
      border-radius: 15px;
      background: rgba(245,240,232,.04);
    }

    .assistant-launcher-mark::after {
      content: "";
      position: absolute;
      right: 9px;
      bottom: -6px;
      width: 10px;
      height: 10px;
      background: #071522;
      border-right: 2px solid var(--amber-light);
      border-bottom: 2px solid var(--amber-light);
      transform: rotate(45deg);
    }

    .assistant-chat-dot {
      width: 4px;
      height: 4px;
      border-radius: 50%;
      background: var(--cream);
      box-shadow: -9px 0 0 var(--cream), 9px 0 0 var(--cream);
    }

    .assistant-launcher-label {
      font-size: 9px;
      line-height: 1;
      letter-spacing: .16em;
      text-transform: uppercase;
      color: var(--amber-light);
      font-weight: 800;
    }

    .assistant-panel {
      position: absolute;
      right: 0;
      bottom: 86px;
      width: min(400px, calc(100vw - 32px));
      max-height: min(680px, calc(100vh - 124px));
      background: var(--cream);
      border: 1px solid var(--rule);
      border-radius: 18px;
      box-shadow: 0 24px 74px rgba(13,27,42,.32);
      display: none;
      flex-direction: column;
      overflow: hidden;
    }

    .assistant-shell.open .assistant-panel {
      display: flex;
    }

    .assistant-header {
      background: var(--navy);
      color: var(--cream);
      padding: 18px;
      border-bottom: 2px solid var(--amber);
      display: flex;
      justify-content: space-between;
      gap: 18px;
      align-items: flex-start;
    }

    .assistant-kicker {
      font-size: 10px;
      letter-spacing: .14em;
      text-transform: uppercase;
      color: var(--amber-light);
      margin-bottom: 5px;
      font-weight: 800;
    }

    .assistant-title {
      font-family: 'Playfair Display', serif;
      font-size: 20px;
      font-weight: 700;
      line-height: 1.15;
    }

    .assistant-close {
      width: 34px;
      height: 34px;
      border: 1px solid rgba(245,240,232,.18);
      background: transparent;
      color: var(--cream);
      cursor: pointer;
      font-size: 20px;
      line-height: 1;
      border-radius: 10px;
    }

    .assistant-messages {
      padding: 18px;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 12px;
      min-height: 260px;
    }

    .assistant-message {
      max-width: 90%;
      padding: 13px 14px;
      font-size: 14px;
      line-height: 1.5;
      color: var(--text-secondary);
      border-radius: 16px;
      overflow-wrap: anywhere;
    }

    .assistant-message.user {
      align-self: flex-end;
      background: linear-gradient(145deg, var(--navy), var(--navy-light));
      color: var(--cream);
      border: 1px solid rgba(245,240,232,.08);
      border-bottom-right-radius: 4px;
      font-size: 13px;
      font-weight: 700;
    }

    .assistant-message.bot {
      align-self: flex-start;
      background: var(--white);
      border: 1px solid rgba(200,184,154,.72);
      border-bottom-left-radius: 4px;
      box-shadow: 0 8px 24px rgba(13,27,42,.06);
    }

    .assistant-links {
      display: grid;
      gap: 8px;
      margin-top: 10px;
    }

    .assistant-links a {
      display: flex;
      justify-content: space-between;
      gap: 12px;
      align-items: center;
      padding: 10px 11px;
      background: var(--white);
      border: 1px solid rgba(200,184,154,.55);
      border-radius: 12px;
      color: var(--navy);
      text-decoration: none;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 800;
    }

    .assistant-links a::after {
      content: "→";
      color: var(--amber);
    }

    .assistant-prompts {
      padding: 0 18px 14px;
      display: grid;
      gap: 8px;
    }

    .assistant-prompts button {
      border: 1px solid rgba(200,184,154,.68);
      border-radius: 12px;
      background: rgba(255,255,255,.72);
      color: var(--navy);
      padding: 11px 12px;
      cursor: pointer;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .07em;
      text-align: left;
      font-weight: 800;
      transition: border-color .2s ease, background .2s ease, transform .2s ease;
    }

    .assistant-prompts button:hover {
      border-color: var(--amber);
      background: var(--white);
      transform: translateX(2px);
    }

    .assistant-form {
      border-top: 1px solid var(--rule-light);
      background: var(--cream-dark);
      padding: 12px;
      display: grid;
      grid-template-columns: 1fr auto;
      gap: 8px;
    }

    .assistant-form input {
      min-width: 0;
      border: 1px solid rgba(13,27,42,.18);
      border-radius: 12px;
      background: rgba(255,255,255,.74);
      color: var(--text-primary);
      padding: 12px;
      font-family: 'DM Sans', sans-serif;
      font-size: 14px;
      outline: none;
    }

    .assistant-form input:focus {
      border-color: var(--amber);
    }

    .assistant-form button {
      border: none;
      border-radius: 12px;
      background: var(--amber);
      color: var(--white);
      padding: 0 16px;
      cursor: pointer;
      font-size: 11px;
      text-transform: uppercase;
      letter-spacing: .1em;
      font-weight: 900;
    }

    .assistant-status {
      padding: 0 18px 14px;
      font-size: 10px;
      color: var(--text-muted);
      text-transform: uppercase;
      letter-spacing: .08em;
      font-weight: 800;
    }

    .brand {
      font-family: 'Playfair Display', serif;
      font-size: 22px;
      font-weight: 600;
      color: var(--white);
    }

    .brand span {
      color: var(--amber);
    }

    .badge {
      border: 1px solid var(--amber);
      color: var(--amber-light);
      background: rgba(200,130,26,.15);
      padding: 6px 16px;
      border-radius: 40px;
      font-size: 12px;
      letter-spacing: 1px;
      text-transform: uppercase;
    }

    .avatar {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: linear-gradient(135deg,var(--navy-mid),var(--navy-light));
      border: 2px solid var(--amber);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: var(--amber-light);
      font-size: 14px;
      box-shadow: 0 0 0 3px rgba(200,130,26,0.15);
      flex-shrink: 0;
    }

    /* HERO SECTION */

    .hero {
      background: linear-gradient(135deg,var(--navy) 0%,var(--navy-mid) 60%,var(--navy-light) 100%);
      padding: 80px 48px 60px;
      position: relative;
    }

    .hero-inner {
      max-width: 1100px;
      margin: 0 auto;
    }

    .hero-label {
      display: flex;
      align-items: center;
      gap: 12px;
      color: var(--amber);
      font-size: 13px;
      letter-spacing: 2px;
      text-transform: uppercase;
      margin-bottom: 24px;
    }

    .hero-label .line {
      width: 28px;
      height: 2px;
      background: var(--amber);
    }

    .hero-card {
      background: var(--cream);
      border-radius: 20px;
      padding: 40px 48px;
      display: flex;
      gap: 48px;
      align-items: center;
      box-shadow: 0 20px 60px rgba(0,0,0,.15);
    }

    .progress-ring {
      width: 150px;
      height: 150px;
      border-radius: 50%;
      background: conic-gradient(var(--amber) var(--progress-deg, 0deg), var(--rule-light) 0deg);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      position: relative;
      box-shadow: inset 0 0 0 1px rgba(13,27,42,0.04);
    }

    .progress-ring::before {
      content: '';
      position: absolute;
      inset: 10px;
      border-radius: 50%;
      background: var(--cream);
    }

    .progress-value {
      font-family: 'Playfair Display', serif;
      font-size: 34px;
      font-weight: 700;
      color: var(--navy);
      position: relative;
      z-index: 1;
    }

    .progress-label {
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-muted);
      position: relative;
      z-index: 1;
    }

    .hero-main h1 {
      font-family: 'Playfair Display', serif;
      font-size: 32px;
      margin: 0 0 8px;
    }

    .subtext {
      color: var(--text-muted);
      margin-bottom: 16px;
    }

    .status-badges span {
      padding: 6px 16px;
      border-radius: 40px;
      font-size: 13px;
      margin-right: 10px;
      border: 1px solid;
    }

    .badge-complete {
      color: #2d6a4f;
      border-color: #2d6a4f;
      background: rgba(45,106,79,.1);
    }

    .badge-progress {
      color: var(--amber);
      border-color: var(--amber);
      background: rgba(200,130,26,.1);
    }

    .badge-queued {
      color: var(--text-muted);
      border-color: var(--rule);
      background: rgba(200,184,154,.15);
    }

    .review-box {
      background: var(--cream-dark);
      padding: 28px 36px;
      border-radius: 16px;
      min-width: 240px;
      text-align: center;
    }

    .review-label {
      font-size: 12px;
      letter-spacing: 2px;
      text-transform: uppercase;
      color: var(--text-muted);
      margin-bottom: 6px;
    }

    .review-date {
      font-family: 'Playfair Display', serif;
      font-size: 24px;
      font-weight: 700;
    }

    .review-sub {
      font-size: 13px;
      color: var(--text-muted);
    }

    /* TABS SECTION */

    .tabs-wrap {
      max-width: 1100px;
      margin: 60px auto 0;
      padding: 0 48px;
      position: relative;
    }

    .tabs {
      display: flex;
      gap: 48px;
      align-items: center;
      overflow-x: auto;
      scrollbar-width: none;
      -webkit-overflow-scrolling: touch;
    }

    .tabs::-webkit-scrollbar {
      display: none;
    }

    .tabs-wrap.is-scrollable::before,
    .tabs-wrap.is-scrollable::after {
      content: "";
      position: absolute;
      top: 0;
      bottom: 10px;
      width: 42px;
      z-index: 2;
      pointer-events: none;
    }

    .tabs-wrap.is-scrollable::before {
      left: 48px;
      background: linear-gradient(90deg, var(--cream-dark), rgba(237,230,214,0));
    }

    .tabs-wrap.is-scrollable::after {
      right: 48px;
      background: linear-gradient(270deg, var(--cream-dark), rgba(237,230,214,0));
    }

    .tabs-wrap.at-start::before,
    .tabs-wrap.at-end::after {
      opacity: 0;
    }

    .tab-scroll-btn {
      position: absolute;
      top: 6px;
      z-index: 3;
      width: 42px;
      height: 42px;
      border-radius: 14px;
      border: 1px solid rgba(200,184,154,.46);
      background: rgba(255,255,255,.58);
      backdrop-filter: blur(10px);
      color: var(--navy);
      box-shadow: 0 14px 34px rgba(13,27,42,.10);
      cursor: pointer;
      display: none;
      align-items: center;
      justify-content: center;
      transition: transform .18s ease, border-color .18s ease, background .18s ease, box-shadow .18s ease, opacity .18s ease;
    }

    .tab-scroll-btn svg {
      width: 22px;
      height: 22px;
      fill: none;
      stroke: currentColor;
      stroke-width: 2.6;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .tab-scroll-btn:hover {
      transform: translateY(-1px);
      border-color: rgba(200,130,26,.42);
      background: rgba(255,255,255,.82);
      box-shadow: 0 18px 40px rgba(13,27,42,.14);
    }

    .tabs-wrap.is-scrollable .tab-scroll-btn {
      display: flex;
    }

    .tabs-wrap.at-start .tab-scroll-left,
    .tabs-wrap.at-end .tab-scroll-right {
      opacity: .18;
      pointer-events: none;
    }

    .tab-scroll-left {
      left: 0;
    }

    .tab-scroll-right {
      right: 0;
    }

    .tab {
      background: none;
      border: none;
      font-family: 'DM Sans', sans-serif;
      font-size: 18px;
      color: var(--text-muted);
      cursor: pointer;
      padding: 16px 0;
      position: relative;
      transition: color .2s ease;
      white-space: nowrap;
      flex: 0 0 auto;
      line-height: 1.1;
    }

    .tab:hover {
      color: var(--text-primary);
    }

    .tab.active {
      color: var(--navy);
      font-weight: 600;
    }

    .tab-underline {
      height: 2px;
      background: var(--rule-light);
      margin-top: -2px;
      width: 100%;
    }

    .tab.active::after {
      content: '';
      position: absolute;
      bottom: -2px;
      left: 0;
      width: 100%;
      height: 3px;
      background: var(--amber);
      border-radius: 2px;
    }

    @media (max-width: 900px) {
      .tabs-wrap {
        padding: 0 20px;
      }

      .tabs-wrap.is-scrollable::before {
        left: 20px;
      }

      .tabs-wrap.is-scrollable::after {
        right: 20px;
      }

      .tabs {
        gap: 24px;
        overflow-x: auto;
      }

      .tab {
        font-size: 16px;
        white-space: nowrap;
      }
    }

    /* CONTENT */

    .portal-root {
      background: var(--cream-dark);
    }

    .content-wrap {
      max-width: 1196px;
      margin: 40px auto 80px;
      padding: 0 48px;
      box-sizing: border-box;
      width: 100%;
    }

    #portalContent {
