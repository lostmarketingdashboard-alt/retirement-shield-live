      font-family: 'DM Sans', sans-serif;
    }

    .consultant-email-btn:hover {
      transform: translateY(-1px);
      box-shadow: 0 16px 34px rgba(200,130,26,.24);
      background: linear-gradient(180deg, rgba(226,150,38,.98) 0%, rgba(200,130,26,.98) 100%);
    }

    .consultant-email-icon {
      width: 24px;
      height: 24px;
      border-radius: 8px;
      background: rgba(255,255,255,.16);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      flex: 0 0 24px;
    }

    .consultant-email-icon svg {
      width: 15px;
      height: 15px;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.9;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .timeline-layout {
      display: flex;
      flex-direction: column;
      gap: 14px;
      margin-bottom: 24px;
    }

    .timeline-item {
      display: grid;
      grid-template-columns: auto minmax(0, 1fr) auto;
      align-items: center;
      gap: 18px;
      background: var(--white);
      border: 1px solid var(--rule-light);
      border-radius: 18px;
      padding: 18px 20px;
      box-shadow: 0 12px 34px rgba(13,27,42,0.06);
    }

    .timeline-marker {
      width: 42px;
      height: 42px;
      border-radius: 50%;
      background: var(--rule);
      color: var(--white);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
    }

    .timeline-item.complete .timeline-marker {
      background: #2d6a4f;
    }

    .timeline-item.progress .timeline-marker {
      background: var(--amber);
    }

    .timeline-title {
      font-weight: 800;
      color: var(--navy);
      margin-bottom: 4px;
    }

    .timeline-item p {
      margin: 0;
      color: var(--text-secondary);
      font-size: 14px;
      line-height: 1.55;
    }

    .tools-body {
      padding-top: 8px;
    }

    .tools-library-head {
      align-items: flex-start;
    }

    .tools-controls {
      display: grid;
      grid-template-columns: minmax(220px, 1fr) 180px;
      gap: 12px;
      min-width: min(460px, 100%);
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 18px;
    }

    .tool-card {
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      gap: 18px;
      min-height: 244px;
      padding: 22px;
      border-radius: 18px;
      border: 1px solid var(--rule-light);
      background: linear-gradient(180deg, rgba(255,255,255,0.96) 0%, rgba(245,240,232,0.96) 100%);
      box-shadow: 0 16px 40px rgba(13,27,42,0.08);
    }

    .tool-card-top {
      display: flex;
      flex-direction: column;
      gap: 14px;
      width: 100%;
    }

    .tool-card-head {
      display: flex;
      justify-content: space-between;
      align-items: center;
      width: 100%;
      gap: 16px;
    }

    .tool-badge {
      width: 64px;
      height: 64px;
      border-radius: 18px;
      display: flex;
      align-items: center;
      justify-content: center;
      color: var(--navy);
      background: linear-gradient(135deg, rgba(13,27,42,0.08), rgba(200,130,26,0.2));
      box-shadow: inset 0 0 0 1px rgba(200,130,26,0.18);
      flex: 0 0 64px;
      box-sizing: border-box;
    }

    .tool-badge svg {
      width: 31px;
      height: 31px;
      display: block;
      fill: none;
      stroke: currentColor;
      stroke-width: 1.8;
      stroke-linecap: round;
      stroke-linejoin: round;
    }

    .tool-category {
      margin-left: auto;
      border: 1px solid var(--rule-light);
      border-radius: 999px;
      padding: 6px 10px;
      color: var(--text-muted);
      background: rgba(255,255,255,.72);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .8px;
      text-transform: uppercase;
      flex-shrink: 0;
    }

    .tool-card-head .tool-restart-btn {
      margin-left: 0;
    }

    .tool-copy h4 {
      margin: 0 0 8px;
      font-size: 19px;
      line-height: 1.35;
      font-family: 'Playfair Display', serif;
      color: var(--navy);
    }

    .tool-copy p {
      margin: 0;
      font-size: 13px;
      line-height: 1.6;
      color: var(--text-secondary);
    }

    .launch-tool-btn {
      width: 100%;
      border: none;
      border-radius: 999px;
      padding: 14px 18px;
      font-size: 14px;
      font-weight: 600;
      cursor: pointer;
      color: var(--white);
      background: linear-gradient(135deg, var(--navy) 0%, var(--navy-light) 100%);
      box-shadow: 0 14px 30px rgba(13,27,42,0.2);
      transition: transform .2s ease, box-shadow .2s ease, filter .2s ease;
    }

    .launch-tool-btn:hover {
      transform: translateY(-2px);
      filter: brightness(1.05);
      box-shadow: 0 18px 36px rgba(13,27,42,0.24);
    }

    .launch-tool-btn.completed {
      background: linear-gradient(135deg, #2d6a4f 0%, #40916c 100%);
      box-shadow: 0 14px 30px rgba(45,106,79,0.22);
    }

    .launch-tool-btn.completed:hover {
      box-shadow: 0 18px 36px rgba(45,106,79,0.28);
    }

    .launch-tool-btn:active {
      transform: translateY(0);
    }

    .tool-restart-btn {
      appearance: none;
      -webkit-appearance: none;
      border: 1px solid rgba(26,46,69,0.18);
      background: linear-gradient(135deg, #d88924 0%, #e8a840 100%);
      color: var(--white);
      display: inline-flex;
      align-items: center;
      justify-content: center;
      border-radius: 999px;
      padding: 8px 14px;
      font-size: 12px;
      font-weight: 700;
      line-height: 1;
      cursor: pointer;
      transition: all .2s ease;
      font-family: 'DM Sans', sans-serif;
      box-shadow: 0 10px 22px rgba(216,137,36,0.22);
      flex-shrink: 0;
      margin-left: auto;
    }

    .tool-restart-btn:hover {
      border-color: #c8821a;
      color: var(--white);
      background: linear-gradient(135deg, #c8821a 0%, #d88924 100%);
      transform: translateY(-1px);
      box-shadow: 0 14px 26px rgba(216,137,36,0.28);
    }

    /* ADMIN PORTAL */

    .admin-hero {
      background: rgba(245,240,232,0.72);
      border: 1px solid var(--rule-light);
      border-radius: 18px;
      padding: 24px 28px;
      margin-bottom: 22px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 24px;
      box-shadow: 0 12px 34px rgba(13,27,42,0.06);
    }

    .admin-hero h2 {
      font-family: 'Playfair Display', serif;
      color: var(--navy);
      margin: 0 0 6px;
      font-size: 30px;
      line-height: 1.12;
    }

    .admin-hero p {
      margin: 0;
      color: var(--text-secondary);
      line-height: 1.6;
      font-size: 14px;
      max-width: 650px;
    }

    .admin-stat-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(112px, 1fr));
      gap: 12px;
      width: min(420px, 100%);
      min-width: 0;
    }

    .admin-stat {
      background: rgba(255,255,255,.74);
      border: 1px solid var(--rule-light);
      border-radius: 16px;
      padding: 16px;
      min-width: 0;
      overflow: hidden;
    }

    .admin-stat.wide-stat {
      grid-column: 1 / -1;
      padding: 12px 22px;
      min-height: 0;
      display: flex;
      flex-direction: column;
      justify-content: center;
    }

    .admin-stat strong {
      display: block;
      font-family: 'Playfair Display', serif;
      font-size: clamp(21px, 2vw, 28px);
      line-height: 1;
      color: var(--navy);
      max-width: 100%;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .admin-stat strong.email-stat {
      font-family: 'DM Sans', sans-serif;
      font-size: clamp(23px, 2vw, 31px);
      line-height: 1.22;
      font-weight: 900;
    }

    .admin-stat span {
      display: block;
      margin-top: 7px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .9px;
      text-transform: uppercase;
    }

    .admin-toolbar {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 14px;
      align-items: center;
      margin-bottom: 22px;
    }

    .admin-panel {
      background: var(--white);
      border-radius: 20px;
      padding: 28px;
      border: 1px solid var(--rule-light);
      box-shadow: 0 20px 60px rgba(0,0,0,.08);
      width: 100%;
      box-sizing: border-box;
    }

    .admin-layout {
      display: grid;
      grid-template-columns: minmax(320px, .82fr) minmax(0, 1.18fr);
      gap: 22px;
      align-items: start;
    }

    .admin-panel-head {
      display: flex;
      justify-content: space-between;
      align-items: flex-start;
      gap: 18px;
      margin-bottom: 20px;
    }

    .admin-panel-head h3 {
      margin: 0;
      font-family: 'Playfair Display', serif;
      color: var(--navy);
      font-size: 24px;
      line-height: 1.2;
    }

    .admin-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .admin-row {
      border: 1px solid var(--rule-light);
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(255,255,255,.98) 0%, rgba(245,240,232,.62) 100%);
      padding: 16px;
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 18px;
      align-items: center;
    }

    .admin-row-main {
      display: flex;
      align-items: center;
      gap: 14px;
      min-width: 0;
    }

    .admin-avatar {
      width: 48px;
      height: 48px;
      border-radius: 15px;
      background: linear-gradient(135deg, rgba(13,27,42,0.08), rgba(200,130,26,0.2));
      border: 1px solid rgba(200,130,26,0.22);
      color: var(--navy);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 800;
      letter-spacing: .8px;
      flex-shrink: 0;
    }

    .admin-row-copy strong {
      display: block;
      color: var(--navy);
      font-size: 16px;
      line-height: 1.25;
      overflow-wrap: anywhere;
    }

    .admin-row-copy > span {
      display: block;
      color: var(--text-muted);
      font-size: 13px;
      margin-top: 4px;
      overflow-wrap: anywhere;
    }

    .admin-pill-row {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;
      margin-top: 10px;
    }

    .admin-pill {
      border: 1px solid var(--rule-light);
      border-radius: 999px;
      padding: 5px 9px;
      color: var(--text-muted);
      background: rgba(255,255,255,.7);
      font-size: 11px;
      font-weight: 800;
      letter-spacing: .7px;
      text-transform: uppercase;
      display: inline-flex;
      white-space: nowrap;
    }

    .admin-pill.success {
      color: #2d6a4f;
      border-color: rgba(45,106,79,.25);
      background: rgba(45,106,79,.08);
    }

    .admin-pill.warn {
      color: #9b6a1c;
      border-color: rgba(200,130,26,.28);
      background: rgba(200,130,26,.1);
    }

    .admin-row-actions {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 10px;
      flex-wrap: wrap;
    }

    .admin-row-actions .profile-input {
      min-width: 130px;
      padding: 10px 12px;
      min-height: 40px;
      font-size: 13px;
    }

    .admin-answer-panel {
      display: none;
      grid-column: 1 / -1;
      border-top: 1px solid var(--rule-light);
      padding-top: 14px;
      margin-top: 4px;
    }

    .admin-answer-panel.open {
      display: block;
    }

    .admin-table-wrap {
      overflow-x: auto;
    }

    .admin-table {
      width: 100%;
      border-collapse: collapse;
      font-size: 14px;
    }

    .article-table {
      min-width: 820px;
    }

    .admin-table th,
    .admin-table td {
      padding: 12px;
      border-bottom: 1px solid var(--rule-light);
      text-align: left;
      vertical-align: top;
      color: var(--text-secondary);
    }

    .admin-table th {
      color: var(--navy);
      font-size: 11px;
      letter-spacing: 1px;
      text-transform: uppercase;
      font-weight: 800;
      background: rgba(245,240,232,.58);
    }

    .admin-table-actions {
      text-align: right !important;
      white-space: nowrap;
    }

    .traffic-toolbar {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      margin-bottom: 20px;
    }

    .traffic-toolbar h3 {
      margin: 0 0 4px;
      font-family: 'Playfair Display', serif;
      color: var(--navy);
      font-size: 24px;
    }

    .traffic-range-controls {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
      justify-content: flex-end;
    }

    .traffic-range-btn {
      border: 1px solid var(--rule-light);
      border-radius: 999px;
      background: rgba(255,255,255,.82);
      color: var(--text-secondary);
      padding: 10px 14px;
      font-family: 'DM Sans', sans-serif;
      font-size: 13px;
      font-weight: 800;
      cursor: pointer;
      transition: all .18s ease;
    }

    .traffic-range-btn.active,
    .traffic-range-btn:hover {
      color: var(--white);
      background: var(--amber);
      border-color: var(--amber);
      box-shadow: 0 10px 22px rgba(200,130,26,.18);
    }

    .traffic-grid {
      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 20px;
    }

    .traffic-chart-grid {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(320px, .6fr);
      gap: 20px;
      margin-bottom: 20px;
    }

    .traffic-panel {
      min-width: 0;
    }

    .traffic-panel .admin-panel-head {
      margin-bottom: 14px;
    }

    .traffic-table td:first-child strong,
    .traffic-table td:first-child span {
      display: block;
      max-width: 360px;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .traffic-table td:first-child span {
      margin-top: 4px;
      color: var(--text-muted);
      font-size: 12px;
    }

    .traffic-recent-list .admin-row {
      align-items: flex-start;
    }

    .traffic-recent-panel {
      margin-top: 20px;
    }

    .traffic-recent-table {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .traffic-recent-head,
    .traffic-recent-row {
      display: grid;
      grid-template-columns: minmax(240px, 1.35fr) minmax(150px, .75fr) 100px minmax(130px, .7fr) 112px;
      gap: 14px;
      align-items: center;
    }

    .traffic-recent-head {
      padding: 0 14px 8px;
      color: var(--text-muted);
      font-size: 11px;
      font-weight: 900;
      letter-spacing: .9px;
      text-transform: uppercase;
      border-bottom: 1px solid var(--rule-light);
    }

    .traffic-recent-row {
      min-height: 68px;
      border: 1px solid var(--rule-light);
      border-radius: 14px;
      padding: 12px 14px;
      background: linear-gradient(180deg, rgba(255,255,255,.98), rgba(245,240,232,.5));
      color: var(--text-secondary);
      font-size: 13px;
    }

    .traffic-recent-page {
      min-width: 0;
    }

    .traffic-recent-page strong,
    .traffic-recent-page span,
    .traffic-recent-row > div {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .traffic-recent-page strong {
      display: block;
      color: var(--navy);
      font-size: 14px;
      line-height: 1.25;
    }

    .traffic-recent-page span {
      display: block;
      margin-top: 4px;
      color: var(--text-muted);
      font-size: 12px;
    }

    .traffic-bars {
      display: flex;
      flex-direction: column;
      gap: 14px;
    }

    .traffic-bar-row {
      display: grid;
      grid-template-columns: minmax(140px, .9fr) minmax(120px, 1fr) 86px;
      align-items: center;
      gap: 14px;
    }

    .traffic-bar-label {
      min-width: 0;
    }

    .traffic-bar-label strong,
    .traffic-bar-label span {
      display: block;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .traffic-bar-label strong {
      color: var(--navy);
      font-size: 14px;
      line-height: 1.3;
    }

    .traffic-bar-label span {
      margin-top: 3px;
      color: var(--text-muted);
      font-size: 12px;
    }

    .traffic-bar-track {
      height: 12px;
      border-radius: 999px;
      background: rgba(200,184,154,.28);
      overflow: hidden;
      box-shadow: inset 0 0 0 1px rgba(200,184,154,.18);
    }

    .traffic-bar-fill {
      height: 100%;
      border-radius: inherit;
      background: linear-gradient(90deg, var(--amber), #e8a840);
      box-shadow: 0 6px 16px rgba(200,130,26,.22);
    }

    .traffic-bar-metric {
      text-align: right;
      color: var(--text-muted);
      font-size: 11px;
      line-height: 1.25;
    }

    .traffic-bar-metric strong {
      display: block;
      color: var(--navy);
      font-size: 17px;
      line-height: 1;
    }

    .traffic-empty {
      border: 1px dashed var(--rule-light);
      border-radius: 14px;
      padding: 18px;
      color: var(--text-muted);
      background: rgba(245,240,232,.44);
    }

    .traffic-empty-state {
      min-height: 260px;
      border: 1px dashed var(--rule-light);
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(255,255,255,.9), rgba(245,240,232,.52));
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      text-align: center;
      gap: 8px;
      padding: 28px;
      color: var(--text-muted);
    }

    .traffic-empty-state strong {
      color: var(--navy);
      font-family: 'Playfair Display', serif;
      font-size: 28px;
      line-height: 1.1;
    }

    .traffic-empty-state span {
      max-width: 420px;
      line-height: 1.5;
    }

    .traffic-donut-layout {
      display: grid;
      grid-template-columns: 150px minmax(0, 1fr);
      gap: 20px;
      align-items: center;
    }

    .traffic-donut {
      position: relative;
      width: 150px;
      height: 150px;
      display: grid;
      place-items: center;
    }

    .traffic-donut svg {
      width: 150px;
      height: 150px;
      transform: rotate(-90deg);
      overflow: visible;
    }

    .traffic-donut div {
      position: absolute;
      inset: 0;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      color: var(--text-muted);
      font-size: 12px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 800;
    }

    .traffic-donut strong {
      color: var(--navy);
      font-family: 'Playfair Display', serif;
      font-size: 34px;
      line-height: .95;
      letter-spacing: 0;
      text-transform: none;
    }

    .traffic-legend {
      display: flex;
      flex-direction: column;
      gap: 10px;
      min-width: 0;
    }

    .traffic-legend-row {
      display: grid;
      grid-template-columns: 12px minmax(0, 1fr) auto;
      gap: 9px;
      align-items: center;
      color: var(--text-secondary);
      font-size: 13px;
    }

    .traffic-legend-row span {
      width: 10px;
      height: 10px;
      border-radius: 50%;
    }

    .traffic-legend-row strong {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .traffic-legend-row em {
      color: var(--navy);
      font-style: normal;
      font-weight: 800;
    }

    .traffic-trend-panel {
      overflow: hidden;
    }

    .traffic-trend-chart {
      height: 220px;
      border: 1px solid var(--rule-light);
      border-radius: 16px;
      background: linear-gradient(180deg, rgba(255,255,255,.82), rgba(245,240,232,.52));
      padding: 14px;
    }

    .traffic-trend-chart svg {
      width: 100%;
      height: 100%;
      display: block;
    }

    .traffic-grid-line {
      fill: none;
      stroke: rgba(122,110,98,.22);
      stroke-width: .35;
    }

    .traffic-area {
      fill: rgba(200,130,26,.13);
    }

    .traffic-line {
      fill: none;
      stroke: var(--amber);
      stroke-width: 2.2;
      stroke-linecap: round;
      stroke-linejoin: round;
      filter: drop-shadow(0 6px 8px rgba(200,130,26,.16));
    }

    .traffic-trend-bars {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(22px, 1fr));
      gap: 8px;
      align-items: end;
      min-height: 96px;
      margin-top: 14px;
      overflow: hidden;
    }

    .traffic-day {
      display: grid;
      grid-template-rows: 74px auto auto;
      align-items: end;
      gap: 5px;
      text-align: center;
      min-width: 0;
    }

    .traffic-day div {
      width: 100%;
      max-width: 18px;
      justify-self: center;
      border-radius: 999px 999px 4px 4px;
      background: linear-gradient(180deg, #e8a840, var(--amber));
    }

    .traffic-day strong {
      color: var(--navy);
      font-size: 12px;
      line-height: 1;
    }

    .traffic-day span {
      color: var(--text-muted);
      font-size: 10px;
      white-space: nowrap;
      overflow: hidden;
