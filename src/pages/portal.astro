        function summarizeTraffic(events, days = 30) {
          const since = Date.now() - days * 24 * 60 * 60 * 1000;
          const filtered = events.filter(event => new Date(event.created_at).getTime() >= since);
          const uniqueVisitors = new Set(filtered.map(event => event.visitor_id).filter(Boolean));

          const groupBy = (getKey, getLabel) => {
            const groups = new Map();
            filtered.forEach(event => {
              const key = getKey(event);
              if (!key) return;
              const existing = groups.get(key) || {
                key,
                label: getLabel(event),
                views: 0,
                visitors: new Set(),
                latest: event.created_at
              };
              existing.views += 1;
              if (event.visitor_id) existing.visitors.add(event.visitor_id);
              if (new Date(event.created_at) > new Date(existing.latest)) existing.latest = event.created_at;
              groups.set(key, existing);
            });

            return Array.from(groups.values())
              .map(group => ({
                ...group,
                visitors: group.visitors.size
              }))
              .sort((a, b) => b.views - a.views)
              .slice(0, 12);
          };

          const dayBuckets = new Map();
          const today = new Date();
          const todayUtc = Date.UTC(today.getUTCFullYear(), today.getUTCMonth(), today.getUTCDate());

          for (let offset = days - 1; offset >= 0; offset -= 1) {
            const date = new Date(todayUtc - offset * 24 * 60 * 60 * 1000);
            const key = date.toISOString().slice(0, 10);
            dayBuckets.set(key, { key, label: date.toLocaleDateString('en-US', { month: 'short', day: 'numeric' }), views: 0 });
          }

          filtered.forEach(event => {
            const key = new Date(event.created_at).toISOString().slice(0, 10);
            if (dayBuckets.has(key)) dayBuckets.get(key).views += 1;
          });

          return {
            events: filtered,
            totalViews: filtered.length,
            uniqueVisitors: uniqueVisitors.size,
            pageCount: new Set(filtered.map(event => event.normalized_path).filter(Boolean)).size,
            stateCount: new Set(filtered.map(event => event.state_slug).filter(Boolean)).size,
            countyCount: new Set(filtered.map(event => event.county_slug ? `${event.state_slug}:${event.county_slug}` : null).filter(Boolean)).size,
            pages: groupBy(
              event => event.normalized_path,
              event => event.page_title || event.normalized_path
            ),
            states: groupBy(
              event => event.state_slug,
              event => event.state_name || event.state_slug
            ),
            counties: groupBy(
              event => event.state_slug && event.county_slug ? `${event.state_slug}:${event.county_slug}` : null,
              event => `${event.county_name || event.county_slug}, ${event.state_name || event.state_slug}`
            ),
            devices: groupBy(
              event => event.device_type,
              event => event.device_type || 'unknown'
            ),
            sources: groupBy(
              event => event.source || event.referrer || 'direct',
              event => getTrafficSourceLabel(event)
            ),
            daily: Array.from(dayBuckets.values())
          };
        }

        function getTrafficSourceLabel(event) {
          if (event.source) return event.source;
          if (!event.referrer) return 'Direct';
          try {
            return new URL(event.referrer).hostname;
          } catch {
            return event.referrer;
          }
        }

