        function attachEvents() {
          document.querySelectorAll('.plan-header').forEach(h => {
            h.onclick = () => {
              const card = h.parentElement
              const isOpen = card.classList.contains('open')

              // Close all cards first
              document.querySelectorAll('.plan-card').forEach(c => c.classList.remove('open'))

              // If it was not open before, open it
              if (!isOpen) {
                card.classList.add('open')
              }
            }
          })

          document.querySelectorAll('.subtask input').forEach(cb => {
            cb.onchange = async (e) => {
              const parentId = e.target.dataset.parent;
              const index = Number(e.target.dataset.index);

              const planItem = actionPlan.find(a => a.id === parentId);
              const subtask = planItem.subtasks[index];

              subtask.done = e.target.checked;

              await supabase
                .from('user_subtask_progress')
                .upsert({
                  user_id: user.id,
                  subtask_id: subtask.id,
                  done: subtask.done
                }, { onConflict: 'user_id,subtask_id' });

              renderPlan();
            }
          })
        }

        (async () => {
          await loadActionPlan();
          renderPlan();
          prefetchUserPortalTabs();
        })();

        const tabs = document.querySelectorAll('.tab')

        tabs.forEach(tab => {
          tab.addEventListener('click', async () => {
            tabs.forEach(t => t.classList.remove('active'))
            tab.classList.add('active')

            const type = tab.dataset.tab

            if (type === 'action') {
              if (!actionPlanLoaded) {
                renderTabLoading('Loading your action plan...');
                await loadActionPlan();
              }
              renderPlan();
            }
            if (type === 'profile') await renderProfile()
            if (type === 'documents') await renderDocuments()
            if (type === 'team') await renderTeam()
            if (type === 'timeline') renderTimeline()
            if (type === 'tools') await renderTools()
          })
        })
      }

      // --- ADMIN USERS TAB LOGIC ---
      if (profile.role === 'admin' || profile.role === 'referral') {

        const adminCache = new Map();
        const adminPending = new Map();
        const adminNotificationState = {
          items: [],
          promise: null,
          toastShown: false
        };

        const adminLoaders = {
          users: async () => {
            const { data } = await supabase
              .from('profiles')
              .select('*')
              .neq('role', 'referral')
              .order('created_at', { ascending: false });
            return data || [];
          },
          templates: async () => {
            const { data } = await supabase
              .from('action_plan_templates')
              .select('*')
              .order('created_at', { ascending: true });
            return data || [];
          },
          templateSubtasks: async () => {
            const { data } = await supabase
              .from('action_plan_template_subtasks')
              .select('*');
            return data || [];
          },
          team: async () => {
            const { data } = await supabase
              .from('profiles')
              .select('*')
              .in('role', ['admin','referral'])
              .order('created_at', { ascending: false });
            return data || [];
          },
          referrals: async () => {
            const { data } = await supabase
              .from('profiles')
              .select('*')
              .eq('role', 'referral');
            return data || [];
          },
          assignmentRows: async () => {
            const { data } = await supabase
              .from('referral_assignments')
              .select('referral_id');
            return data || [];
          },
          articles: async () => {
            const { data, error } = await supabase
              .from('articles')
              .select('*')
              .order('published_at', { ascending: false });
            if (error) throw error;
            return data || [];
          },
          notifications: async () => {
            const { data, error } = await supabase
              .from('portal_notifications')
              .select('*')
              .order('created_at', { ascending: false });
            if (error) throw error;
            return data || [];
          },
          traffic: async () => {
            const since = new Date(Date.now() - 90 * 24 * 60 * 60 * 1000).toISOString();
            const { data, error } = await supabase
              .from('page_traffic_events')
              .select('created_at, page_path, normalized_path, page_title, referrer, state_name, state_slug, county_name, county_slug, visitor_id, session_id, device_type, source, medium, campaign')
              .gte('created_at', since)
              .order('created_at', { ascending: false })
              .limit(10000);
            if (error) throw error;
            return data || [];
          }
        };

        async function getAdminData(key, { force = false } = {}) {
          if (!force && adminCache.has(key)) return adminCache.get(key);
          if (!force && adminPending.has(key)) return adminPending.get(key);

          const pending = adminLoaders[key]().then(data => {
            adminCache.set(key, data);
            adminPending.delete(key);
            return data;
          }).catch(error => {
            adminPending.delete(key);
            throw error;
          });

          adminPending.set(key, pending);
          return pending;
        }

        function invalidateAdminData(...keys) {
          keys.forEach(key => {
            adminCache.delete(key);
            adminPending.delete(key);
          });
        }

        function prefetchAdminTabs() {
          if (profile.role === 'admin') {
            ['users', 'templates', 'templateSubtasks', 'team', 'referrals', 'assignmentRows', 'articles', 'notifications', 'traffic'].forEach(key => {
              getAdminData(key).catch(() => {});
            });
          }
        }

        function getAdminNotificationOccurrenceKey(notification) {
          const sourceDate = notification.send_at || notification.created_at || new Date().toISOString();
          return `admin-${notification.id}-${sourceDate}`;
        }

        async function getAdminNotificationCenter({ force = false } = {}) {
          if (profile.role !== 'admin') return [];
          if (!force && adminNotificationState.items.length) return adminNotificationState.items;
          if (!force && adminNotificationState.promise) return adminNotificationState.promise;

          adminNotificationState.promise = (async () => {
            const now = new Date();
            const { data: notifications, error } = await supabase
              .from('portal_notifications')
              .select('*')
              .eq('active', true)
              .or(`audience.eq.admin,audience.eq.all,recipient_user_id.eq.${user.id}`)
              .or(`send_at.is.null,send_at.lte.${now.toISOString()}`)
              .order('created_at', { ascending: false });

            if (error) {
              console.error(error);
              adminNotificationState.items = [];
              return [];
            }

            const relevant = (notifications || [])
              .filter(notification => {
                if (notification.recipient_user_id && notification.recipient_user_id !== user.id) return false;
                const repeatUntil = notification.repeat_until ? new Date(notification.repeat_until) : null;
                if (repeatUntil && repeatUntil < now) return false;
                return ['admin', 'all'].includes(notification.audience || 'all') || notification.recipient_user_id === user.id;
              })
              .map(notification => ({
                ...notification,
                occurrenceKey: getAdminNotificationOccurrenceKey(notification)
              }));

            if (!relevant.length) {
              adminNotificationState.items = [];
              return [];
            }

            const { data: dismissals } = await supabase
              .from('portal_notification_dismissals')
              .select('notification_id, occurrence_key')
              .eq('user_id', user.id);

            const dismissed = new Set((dismissals || []).map(row => `${row.notification_id}:${row.occurrence_key}`));
            adminNotificationState.items = relevant.filter(notification => !dismissed.has(`${notification.id}:${notification.occurrenceKey}`));
            return adminNotificationState.items;
          })();

          try {
            return await adminNotificationState.promise;
          } finally {
            adminNotificationState.promise = null;
          }
        }

        async function refreshAdminNotificationCenter({ force = false } = {}) {
          if (profile.role !== 'admin') return;
          const notifications = await getAdminNotificationCenter({ force });
          const countEl = document.getElementById('notificationCount');
          const btn = document.getElementById('notificationBtn');
          if (countEl) countEl.textContent = String(notifications.length);
          if (btn) btn.classList.toggle('has-notifications', notifications.length > 0);
          renderAdminNotificationDrawer(notifications);
          if (!adminNotificationState.toastShown) {
            adminNotificationState.toastShown = true;
            showNotificationToast(notifications.length);
          }
        }

        function renderAdminNotificationDrawer(notifications = adminNotificationState.items) {
          const list = document.getElementById('notificationList');
          if (!list) return;

          if (!notifications.length) {
            list.innerHTML = `<div class="notification-empty">No admin messages right now.</div>`;
            return;
          }

          list.innerHTML = notifications.map(notification => `
            <article class="notification-item">
              <button class="notification-x" type="button" data-dismiss-admin-notification="${notification.id}" data-occurrence-key="${escapeHtml(notification.occurrenceKey)}">×</button>
              <div class="notification-title">${escapeHtml(notification.title)}</div>
              <p>${escapeHtml(notification.body)}</p>
              <div class="notification-meta">
                Admin message
                ${notification.created_at ? ` · ${new Date(notification.created_at).toLocaleDateString('en-US', { month: 'short', day: 'numeric' })}` : ''}
              </div>
            </article>
          `).join('');

          document.querySelectorAll('[data-dismiss-admin-notification]').forEach(btn => {
            btn.addEventListener('click', async () => {
              const notificationId = btn.dataset.dismissAdminNotification;
              const occurrenceKey = btn.dataset.occurrenceKey;

              await supabase
                .from('portal_notification_dismissals')
                .upsert({
                  notification_id: notificationId,
                  user_id: user.id,
                  occurrence_key: occurrenceKey
                }, { onConflict: 'notification_id,user_id,occurrence_key' });

              adminNotificationState.items = adminNotificationState.items.filter(notification => notification.id !== notificationId || notification.occurrenceKey !== occurrenceKey);
              await refreshAdminNotificationCenter({ force: true });
            });
          });
        }

        const adminNotificationBtn = document.getElementById('notificationBtn');
        const adminNotificationDrawer = document.getElementById('notificationDrawer');
        const adminCloseNotificationDrawer = document.getElementById('closeNotificationDrawer');

        if (profile.role === 'admin' && adminNotificationBtn && adminNotificationDrawer) {
          adminNotificationBtn.addEventListener('click', async () => {
            adminNotificationDrawer.classList.add('open');
            adminNotificationDrawer.setAttribute('aria-hidden', 'false');
            await refreshAdminNotificationCenter({ force: true });
          });

          adminCloseNotificationDrawer?.addEventListener('click', () => {
            adminNotificationDrawer.classList.remove('open');
            adminNotificationDrawer.setAttribute('aria-hidden', 'true');
          });

          adminNotificationDrawer.addEventListener('click', (event) => {
            if (event.target === adminNotificationDrawer) {
              adminNotificationDrawer.classList.remove('open');
              adminNotificationDrawer.setAttribute('aria-hidden', 'true');
            }
          });

          refreshAdminNotificationCenter().catch(() => {});
        }

