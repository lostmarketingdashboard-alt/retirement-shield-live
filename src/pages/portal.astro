    /* ACTION PLAN CARDS */

    .plan-card {
      background: var(--white);
      border-radius: 16px;
      border: 1px solid var(--rule-light);
      margin-bottom: 20px;
      overflow: hidden;
      transition: all .25s ease;
      box-shadow: 0 6px 24px rgba(0,0,0,.05);
    }

    .plan-card.complete .plan-number {
      background: #2d6a4f;
    }

    .plan-card.progress .plan-number {
      background: var(--amber);
    }

    .plan-card.queued .plan-number {
      background: var(--rule);
      color: var(--text-muted);
    }

    .plan-header {
      padding: 22px 28px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      cursor: pointer;
      transition: background .2s ease;
    }

    .plan-header:hover {
      background: rgba(0,0,0,0.02);
    }

    .plan-left {
      display: flex;
      align-items: center;
      gap: 18px;
      min-width: 0;
    }

    .plan-number {
      width: 44px;
      height: 44px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      color: var(--white);
      font-size: 15px;
      transition: all .2s ease;
    }

    .plan-left h3 {
      margin: 0;
      font-size: 18px;
      font-weight: 600;
    }

    .plan-right {
      display: flex;
      align-items: center;
      gap: 10px;
      flex-shrink: 0;
    }

    .plan-count {
      color: var(--text-muted);
      border: 1px solid var(--rule-light);
      border-radius: 999px;
      padding: 6px 12px;
      font-size: 12px;
      font-weight: 700;
      background: rgba(245,240,232,.65);
    }

    .plan-category {
      font-size: 13px;
      color: var(--text-muted);
      margin-top: 4px;
    }

    .plan-status {
      font-size: 12px;
      padding: 6px 14px;
      border-radius: 40px;
      text-transform: uppercase;
      letter-spacing: 1px;
      font-weight: 600;
    }

    .plan-card.complete .plan-status {
      background: rgba(45,106,79,.1);
      color: #2d6a4f;
    }

    .plan-card.progress .plan-status {
      background: rgba(200,130,26,.1);
      color: var(--amber);
    }

    .plan-card.queued .plan-status {
      background: rgba(200,184,154,.2);
      color: var(--text-muted);
    }

    .plan-body {
      padding: 0 28px 28px;
      display: none;
      border-top: 1px solid var(--rule-light);
      background: rgba(0,0,0,0.01);
      animation: fadeIn .25s ease;
    }

    .plan-card.open .plan-body {
      display: block;
    }

    .subtasks {
      margin-top: 18px;
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .subtask {
      font-size: 14px;
      display: flex;
      align-items: center;
      gap: 10px;
      cursor: pointer;
    }

    .subtask input {
      width: 18px;
      height: 18px;
      accent-color: var(--amber);
      cursor: pointer;
    }

    /* Custom Subtask Checkbox Styling */

    .subtask {
      position: relative;
      cursor: pointer;
      font-size: 16px;
      gap: 14px;
    }

    .subtask input {
      position: absolute;
      opacity: 0;
      width: 1px;
      height: 1px;
      pointer-events: none;
    }

    .subtask input:focus-visible + .custom-check {
      outline: 3px solid rgba(200,130,26,.28);
      outline-offset: 3px;
    }

    .custom-check {
      width: 22px;
      height: 22px;
      border-radius: 50%;
      border: 2px solid #cfd6dc;
      display: flex;
      align-items: center;
      justify-content: center;
      transition: all .2s ease;
      flex-shrink: 0;
    }

    .subtask.done .custom-check {
      background: #2d6a4f;
      border-color: #2d6a4f;
    }

    .subtask.done .custom-check::after {
      content: '✓';
      color: white;
      font-size: 14px;
      font-weight: 700;
    }

    .task-label {
      transition: all .2s ease;
    }

    .subtask.done .task-label {
      text-decoration: line-through;
      color: #6b7280;
    }

    @keyframes fadeIn {
      from { opacity: 0; transform: translateY(-4px); }
      to { opacity: 1; transform: translateY(0); }
    }



