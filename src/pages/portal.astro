          const state = document.getElementById('profileState')?.value || profile.state || '';
          const county = document.getElementById('profileCounty')?.value || profile.county || '';
          const nameParts = splitFullName(fullName);
          const updatedAnswers = { ...(baseAnswers || {}) };

          updatedAnswers.firstName = nameParts.firstName;
          updatedAnswers.lastName = nameParts.lastName;
          updatedAnswers.email = email;
          updatedAnswers.state = state;
          updatedAnswers.county = county;

          document.querySelectorAll('[data-answer-field]').forEach(fieldEl => {
            updatedAnswers[fieldEl.dataset.answerField] = fieldEl.value;
          });

          return updatedAnswers;
        }

        async function saveProfileQuizAnswers({ showToast = false } = {}) {
          const latestQuizSubmission = await getLatestQuizSubmission({ force: true });
          const updatedAnswers = collectProfileQuizAnswers(latestQuizSubmission?.answers || {});

          const quizWrite = latestQuizSubmission?.id
            ? await supabase
              .from('quiz_submissions')
              .update({ answers: updatedAnswers })
              .eq('id', latestQuizSubmission.id)
              .select('id, answers, created_at')
              .maybeSingle()
            : await supabase
              .from('quiz_submissions')
              .insert({ user_id: user.id, answers: updatedAnswers })
              .select('id, answers, created_at')
              .maybeSingle();

          if (quizWrite.error) {
            console.error('Quiz answer save error:', quizWrite.error);
            if (showToast) showPortalStatusToast('Unable to save', 'That quiz answer was not saved. Please try again.');
            return { error: quizWrite.error };
          }

          userTabCache.quizSubmission = quizWrite.data || {
            id: latestQuizSubmission?.id || null,
            answers: updatedAnswers,
            created_at: latestQuizSubmission?.created_at || null
          };

          if (showToast) showPortalStatusToast('Change saved', 'Your onboarding answer has been updated.');
          return { data: userTabCache.quizSubmission };
        }

