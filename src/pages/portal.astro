              popup.className = 'admin-modal';

              popup.innerHTML = `
                <div class="admin-modal-card">
                  <div class="admin-panel-head">
                    <div>
                      <h3>Select Members</h3>
                      <div class="doc-meta">Choose which users this referral partner can see.</div>
