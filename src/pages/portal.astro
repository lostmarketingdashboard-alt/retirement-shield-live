              // Load all normal users from the admin cache when available.
              const users = (await getAdminData('users')).filter(u => u.role === 'user');

              // Load existing assignments
              const { data: existingAssignments } = await supabase
                .from('referral_assignments')
                .select('user_id')
                .eq('referral_id', referralId);

